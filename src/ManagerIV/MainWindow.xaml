<Window x:Class="ManagerIV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ManagerIV"
        xmlns:views="clr-namespace:ManagerIV.Views"
        xmlns:vm="clr-namespace:ManagerIV.ViewModels"
        mc:Ignorable="d"
        Title="GTA IV Mod Loader" 
        Height="700" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#FF111111"
        Foreground="White">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" /> <!-- Sidebar Column -->
            <ColumnDefinition Width="*" />   <!-- Main Content Column -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar Grid -->
        <Grid Grid.Column="0" Background="#FF181818">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- App Header -->
                <RowDefinition Height="*" />     <!-- Navigation List -->
                <RowDefinition Height="Auto" />  <!-- Deployment & Status Panel -->
            </Grid.RowDefinitions>

            <!-- App Header -->
            <StackPanel Grid.Row="0" Margin="20,25,20,25">
                <TextBlock Text="GTA IV MOD LOADER" FontSize="18" FontWeight="Black" Foreground="#FF107C41" />
                <TextBlock Text="Complete Edition Manager" FontSize="11" Foreground="#FFAAAAAA" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Navigation List -->
            <ListBox x:Name="SidebarListBox" 
                     Grid.Row="1" 
                     SelectedIndex="0" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     Margin="10,0">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="15,12" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF252525" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF202020" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Resources>

                <!-- Nav Item 1: Mod Library -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Library24" Filled="True" Foreground="#FF107C41" />
                        <TextBlock Text="Mod Library" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="White" />
                    </StackPanel>
                </ListBoxItem>

                <!-- Nav Item 2: Profiles & Config -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Filled="True" Foreground="#FF107C41" />
                        <TextBlock Text="Profiles &amp; Settings" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="White" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- Deployment & Status Panel -->
            <StackPanel Grid.Row="2" Margin="20,15,20,20">
                <!-- Active Profile Info -->
                <ui:Card Padding="10" Margin="0,0,0,15" Background="#FF1F1F1F" BorderBrush="#FF2A2A2A">
                    <StackPanel>
                        <TextBlock Text="ACTIVE PROFILE" FontSize="9" FontWeight="Bold" Foreground="#FFAAAAAA" />
                        <TextBlock Text="{Binding ActiveProfile.Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:Card>

                <!-- Apply Deployment Button -->
                <ui:Button Content="Apply Load Order" 
                           Icon="{ui:SymbolIcon Play24}" 
                           Command="{Binding ApplyDeploymentCommand}"
                           Appearance="Primary" 
                           Height="42" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Stretch" />

                <!-- Status Text bar -->
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#FFAAAAAA" Margin="0,12,0,0" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <TabControl Grid.Column="1" 
                    SelectedIndex="{Binding SelectedIndex, ElementName=SidebarListBox}"
                    Background="#FF141414"
                    BorderThickness="0"
                    Padding="0">
            <TabControl.Resources>
                <!-- Hide the TabControl header strip completely -->
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </TabControl.Resources>

            <TabItem>
                <views:ModLibraryView DataContext="{Binding}" />
            </TabItem>
            <TabItem>
                <views:ProfileSwitcherView DataContext="{Binding}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
