<Window x:Class="ManagerIV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ManagerIV"
        xmlns:views="clr-namespace:ManagerIV.Views"
        xmlns:vm="clr-namespace:ManagerIV.ViewModels"
        mc:Ignorable="d"
        Title="GTA IV Mod Loader" 
        Height="700" Width="1050"
        MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" /> <!-- Sidebar Column -->
            <ColumnDefinition Width="*" />   <!-- Main Content Column -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar Grid -->
        <Grid Grid.Column="0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- App Header -->
                <RowDefinition Height="*" />     <!-- Navigation List -->
                <RowDefinition Height="Auto" />  <!-- Deployment & Status Panel -->
            </Grid.RowDefinitions>

            <!-- App Header -->
            <StackPanel Grid.Row="0" Margin="20,25,20,25">
                <TextBlock Text="GTA IV MOD LOADER" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                <TextBlock Text="{Binding GameVersionDisplayString}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Navigation List -->
            <ListBox x:Name="SidebarListBox" 
                     Grid.Row="1" 
                     SelectedIndex="0" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     VirtualizingPanel.ScrollUnit="Pixel"
                     Margin="10,0">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="15,12" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <Grid>
                                            <!-- Left-edge focus indicator strip -->
                                            <Border x:Name="EdgeStrip" Width="3" HorizontalAlignment="Left" CornerRadius="3" Margin="0,6" Background="Transparent" />
                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Hover: subtle surface fill + secondary-accent edge -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                            <Setter TargetName="EdgeStrip" Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                        </Trigger>
                                        <!-- Selected: muted-accent fill + 3px primary-accent edge (wins over hover) -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MutedAccentBrush}" />
                                            <Setter TargetName="EdgeStrip" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Resources>

                <!-- Nav Item 1: Mod Library -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Library24" Filled="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                        <TextBlock Text="Mod Library" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>

                <!-- Nav Item 2: Profiles & Config -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Filled="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                        <TextBlock Text="Profiles &amp; Config" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>

                <!-- Nav Item 3: Backend Config -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Options24" Filled="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                        <TextBlock Text="Backend Config" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>

                <!-- Nav Item 4: Music Manager -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="MusicNote224" Filled="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                        <TextBlock Text="Music Manager" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>

                <!-- Nav Item 5: Settings -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Wrench24" Filled="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                        <TextBlock Text="Settings" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>

                <!-- Nav Item 6: Logger -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Document24" Filled="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                        <TextBlock Text="Logger" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>

                <!-- Nav Item 7: Credits -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="People24" Filled="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                        <TextBlock Text="Credits" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- Deployment & Status Panel -->
            <StackPanel Grid.Row="2" Margin="20,15,20,20">
                <!-- Active Profile Info -->
                <ui:Card Padding="10" Margin="0,0,0,15" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE PROFILE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActiveProfile.Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:Card>

                <!-- Apply Deployment Button -->
                <ui:Button Content="Apply Load Order" 
                           Command="{Binding ApplyDeploymentCommand}"
                           AutomationProperties.Name="Apply Load Order"
                           Appearance="Primary" 
                           Height="42" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Stretch" />

                <!-- Status Text bar -->
                <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <TabControl Grid.Column="1"
                    SelectedIndex="{Binding SelectedIndex, ElementName=SidebarListBox}"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="0"
                    Padding="0">
            <TabControl.Resources>
                <!-- Collapse the TabPanel header strip entirely so it reserves no
                     vertical offset (removes the un-themed line at the top of views). -->
                <Style TargetType="{x:Type TabPanel}">
                    <Setter Property="Height" Value="0" />
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
                <!-- Hide the TabControl header strip completely -->
                <Style x:Key="CollapsedTabItemStyle" TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </TabControl.Resources>

            <TabItem Style="{StaticResource CollapsedTabItemStyle}">
                <views:ModLibraryView DataContext="{Binding}" />
            </TabItem>
            <TabItem Style="{StaticResource CollapsedTabItemStyle}">
                <views:ProfileSwitcherView DataContext="{Binding}" />
            </TabItem>
            <TabItem Style="{StaticResource CollapsedTabItemStyle}">
                <views:FusionFixConfigView DataContext="{Binding}" />
            </TabItem>
            <TabItem Style="{StaticResource CollapsedTabItemStyle}">
                <views:MusicView DataContext="{Binding}" />
            </TabItem>
            <TabItem Style="{StaticResource CollapsedTabItemStyle}">
                <views:SettingsView DataContext="{Binding}" />
            </TabItem>
            <TabItem Style="{StaticResource CollapsedTabItemStyle}">
                <views:LoggerView DataContext="{Binding}" />
            </TabItem>
            <TabItem Style="{StaticResource CollapsedTabItemStyle}">
                <views:CreditsView DataContext="{Binding}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
