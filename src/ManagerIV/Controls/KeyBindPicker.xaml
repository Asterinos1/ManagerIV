<UserControl x:Class="ManagerIV.Controls.KeyBindPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="RootPicker">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:Button x:Name="BindButton"
                   Width="140"
                   Height="32"
                   Padding="8,4"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"
                   Click="BindButton_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:SymbolIcon x:Name="BindIcon" Symbol="Keyboard24" Margin="0,0,6,0" FontSize="14" />
                <TextBlock x:Name="BindText" Text="Alt" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="100" />
            </StackPanel>
        </ui:Button>

        <ui:Button x:Name="ClearButton"
                   Icon="{ui:SymbolIcon Dismiss16}"
                   Appearance="Transparent"
                   Padding="4"
                   Margin="4,0,0,0"
                   Width="28"
                   Height="28"
                   ToolTip="Clear / Unbind Key"
                   Click="ClearButton_Click" />
    </StackPanel>
</UserControl>
