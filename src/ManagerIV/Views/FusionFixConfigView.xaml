                                            <TextBlock Text="Presets:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                                            <ui:Button Content="Auto-Detect Budget" Command="{Binding AutoCalculateVehicleBudgetCommand}" Margin="0,0,5,0" Padding="10,4" FontSize="11" />
                                            <ui:Button Content="120 MB (Low/Vanilla)" Command="{Binding SetVehicleBudgetPresetCommand}" CommandParameter="120000000" Margin="0,0,5,0" Padding="10,4" FontSize="11" />
                                            <ui:Button Content="260 MB (Heavy Mods)" Command="{Binding SetVehicleBudgetPresetCommand}" CommandParameter="260000000" Margin="0,0,5,0" Padding="10,4" FontSize="11" />
                                            <ui:Button Content="Default (0)" Command="{Binding SetVehicleBudgetPresetCommand}" CommandParameter="0" Margin="0,0,5,0" Padding="10,4" FontSize="11" />
                                        </StackPanel>

                                        <!-- Warning Message -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                                   Text="{Binding VehicleBudgetWarning}" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding HasVehicleBudgetWarning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                                    </Grid>
                                </ui:Card>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Pedestrian Budget Limit" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Exposes pedestrian model memory sizes to prevent spawns freeze bugs." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.PedBudget, Mode=TwoWay}" Width="100" VerticalAlignment="Center" TextAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Extended Engine Limits" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Enlarges default index bounds (modelinfo, carcols pool size limits)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.ExtendedLimitsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <TextBlock Text="Episodic Content Overrides" FontSize="15" FontWeight="Bold" Margin="0,5,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Episodic Vehicles Support" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Enables episodic cars (APC, Buzzard, Blade) inside IV and TLaD." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.EpisodicVehiclesEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Episodic Weapons Support" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Enables episodic weapon arrays (AA12, sticky bombs, DSR1) inside IV." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.EpisodicWeaponsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Explosive Rounds on Annihilator" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Maps explosive gun ammo to the Annihilator helicopter inside IV." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.ExplosiveAnnihilatorEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Other Episodic Engine Checks" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Enables altimeter, phone features, and disco bobbing inside IV." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.OtherEpisodicChecksEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="TBoGT Helicopter Height Limit" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Raises standard IV and TLaD helicopter altitude limit to match TBoGT." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.TBoGTHelicopterHeightLimitEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="TBoGT Police Loadout Overrides" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Gives P90, AA12, and M249 weapons to SWAT and police units." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.TBoGTPoliceWeaponsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Remove SCO Signature Check" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Allows loading custom episodic compiled scripts (.sco files) across IV." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.RemoveSCOSignatureCheckEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <TextBlock Text="Indicators &amp; MSAA Settings" FontSize="15" FontWeight="Bold" Margin="0,5,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Manual Turn Signals Indicators" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Enables vehicle turn signals (triggered via keyboard brackets or controller)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.ManualTurnIndicatorsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                             <TextBlock Text="Turn Signal Key Binds" FontSize="13" FontWeight="SemiBold" />
                                             <TextBlock Text="Assign keyboard keys or mouse buttons (e.g. side buttons) to trigger Left and Right turn signals." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Left:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <controls:KeyBindPicker KeyHexCode="{Binding FusionFixSettings.LeftIndicatorKey, Mode=TwoWay}" Margin="0,0,12,0" />
                                        <TextBlock Text="Right:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <controls:KeyBindPicker KeyHexCode="{Binding FusionFixSettings.RightIndicatorKey, Mode=TwoWay}" />
                                    </StackPanel>
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Reflection MSAA Quality" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Applies multi-sample anti-aliasing to mirrors, water, and car maps." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox SelectedValue="{Binding FusionFixSettings.ReflectionMSAAQuality, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Disabled (0)" Tag="0" />
                                        <ComboBoxItem Content="2x MSAA (2)" Tag="2" />
                                        <ComboBoxItem Content="4x MSAA (4)" Tag="4" />
                                        <ComboBoxItem Content="8x MSAA (8)" Tag="8" />
                                    </ComboBox>
                                </ui:CardControl>

                                <TextBlock Text="User Profile &amp; Save Paths" FontSize="15" FontWeight="Bold" Margin="0,5,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Custom User Profile Path" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Redirects save games and user settings directory to a custom path (Leave blank for default)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.CustomUserProfilePath, Mode=TwoWay}" Width="150" VerticalAlignment="Center" PlaceholderText="e.g. C:\MySaves" />
                                </ui:CardControl>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </Grid>

                <!-- DXVK Settings Tab -->
                <Grid Visibility="{Binding IsDxvkTabActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <!-- Show warning if DXVK settings are missing -->
                    <Grid Grid.RowSpan="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDxvkConfigAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ui:Card Padding="20" Margin="0,20,15,20" MaxWidth="500" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Info24" FontSize="36" Foreground="{DynamicResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="DXVK Configuration Not Found" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                <TextBlock Text="dxvk.conf was not found in your game directory. Please install DXVK or run the game once to generate it." TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:Card>
                    </Grid>

                    <ui:TextBox x:Name="DxvkSearchBox" 
                                Grid.Row="0"
                                PlaceholderText="Search settings by title or description..."
                                TextChanged="DxvkSearchBox_TextChanged"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Icon="{ui:SymbolIcon Search24}"
                                Margin="0,5,15,10"
                                MaxWidth="800"
                                HorizontalAlignment="Left"
                                Width="400"
                                Visibility="{Binding IsDxvkConfigAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,5,0,0">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDxvkConfigAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        
                        <StackPanel x:Name="DxvkSettingsStackPanel" MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,0,15,10">
                            <!-- General & Presentation -->
                            <TextBlock Text="General &amp; Presentation" FontSize="15" FontWeight="Bold" Margin="0,10,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                            
                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Force Aspect Ratio" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Only exposes display modes with a given aspect ratio." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.ForceAspectRatio, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Default" Tag="" />
                                    <ComboBoxItem Content="16:9" Tag="16:9" />
                                    <ComboBoxItem Content="21:9" Tag="21:9" />
                                    <ComboBoxItem Content="4:3" Tag="4:3" />
                                    <ComboBoxItem Content="16:10" Tag="16:10" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Force Refresh Rate" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Forces a specific refresh rate (Hz). Set to 0 to disable." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding DxvkSettings.D3d9ForceRefreshRate, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Vertical Sync (VSync)" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Synchronizes output frames to refresh rate to prevent screen tearing." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.PresentIntervalEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Tear Free" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Enables mailbox present mode to eliminate tearing without full VSync overhead." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.DxvkTearFree, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="True" Tag="True" />
                                    <ComboBoxItem Content="False" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Enumerate by Displays" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Enumerates D3D9 adapters by display (Windows behavior) rather than physical adapter." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9EnumerateByDisplays, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Mode Count Compatibility" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Aggressively restricts the reported display resolution modes to avoid crashes." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9ModeCountCompatibility, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Dummy Composition Swapchains" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Exposes mock support for dcomp swap chains." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.DxgiEnableDummyCompositionSwapchain, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Allow FSE" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Allows exclusive full-screen mode on Windows. Needed for VRR/HDR support." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.DxvkAllowFse, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Defer Surface Creation" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Defers creating Vulkan VkSurface until the first Present call." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9DeferSurfaceCreation, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <!-- Performance & Latency -->
                            <TextBlock Text="Performance &amp; Latency" FontSize="15" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Max Frame Latency" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Enforces strict frame latency limits. Higher values improve throughput, lower reduces lag." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.D3d9MaxFrameLatency, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Driver Default (0)" Tag="0" />
                                    <ComboBoxItem Content="1 Frame" Tag="1" />
                                    <ComboBoxItem Content="2 Frames" Tag="2" />
                                    <ComboBoxItem Content="3 Frames" Tag="3" />
                                    <ComboBoxItem Content="4 Frames" Tag="4" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Frame Rate Limit" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Enforces maximum frame rate limit. Set to 0 to disable." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding DxvkSettings.D3d9MaxFrameRate, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Latency Sleep (Reflex)" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Controls Vulkan latency reduction sleep and Reflex support." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.DxvkLatencySleep, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="Enabled" Tag="True" />
                                    <ComboBoxItem Content="Disabled" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Latency Sleep Tolerance" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Tolerance for latency sleep (microseconds). Higher values improve frame pacing." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding DxvkSettings.DxvkLatencyTolerance, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Disable NV lowLatency2" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Disables lowLatency2 extension for Nvidia GPUs." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.DxvkDisableNvLowLatency2, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="True" Tag="True" />
                                    <ComboBoxItem Content="False" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Compiler Threads" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Pipeline compiler threads. Set to 0 to use all available cores." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding DxvkSettings.DxvkNumCompilerThreads, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Graphics Pipeline Library" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Controls VK_EXT_graphics_pipeline_library features to reduce shader compile stutter." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.DxvkEnableGraphicsPipelineLibrary, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="Enabled" Tag="True" />
                                    <ComboBoxItem Content="Disabled" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Track Pipeline Lifetime" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Aggressively frees pipeline libraries to save address space memory." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.DxvkTrackPipelineLifetime, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="True" Tag="True" />
                                    <ComboBoxItem Content="False" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Memory Defragmentation" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Enables automatic VRAM memory defragmentation." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.DxvkEnableMemoryDefrag, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="True" Tag="True" />
                                    <ComboBoxItem Content="False" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Cached Default-Pool Buffers" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Allocates default-pool buffers in cached memory. May hurt performance but fixes buggy software." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9CachedWriteOnlyBuffers, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <!-- Graphics & Rendering -->
                            <TextBlock Text="Graphics &amp; Rendering" FontSize="15" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Enable HDR" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Exposes HDR10 color space support to the application." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.DxgiEnableHDR, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Sampler Anisotropy" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Forces anisotropic texture filtering level. Set to -1 for default, or 0-16." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.D3d9SamplerAnisotropy, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Default (-1)" Tag="-1" />
                                    <ComboBoxItem Content="Off (0)" Tag="0" />
                                    <ComboBoxItem Content="2x" Tag="2" />
                                    <ComboBoxItem Content="4x" Tag="4" />
                                    <ComboBoxItem Content="8x" Tag="8" />
                                    <ComboBoxItem Content="16x" Tag="16" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Sampler LOD Bias" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Adds detail offset to mipmaps. Positive decreases texture sharpness; negative increases it." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding DxvkSettings.D3d9SamplerLodBias, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Clamp Negative LOD Bias" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Clamps negative LOD bias to 0 to prevent texture shimmering." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9ClampNegativeLodBias, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Force Sample Rate Shading" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Forces sample rate shading on MSAA targets. Improves visuals at severe GPU cost." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9ForceSampleRateShading, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Shader Model" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Overrides reported shader model capabilities level." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.D3d9ShaderModel, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Fixed Function (0)" Tag="0" />
                                    <ComboBoxItem Content="Shader Model 1" Tag="1" />
                                    <ComboBoxItem Content="Shader Model 2" Tag="2" />
                                    <ComboBoxItem Content="Shader Model 3" Tag="3" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Float Emulation Quirks" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Enables floating point emulation workarounds. Auto is recommended." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.D3d9FloatEmulation, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="Fast Approximations" Tag="True" />
                                    <ComboBoxItem Content="Disabled" Tag="False" />
                                    <ComboBoxItem Content="Strict Compliance" Tag="Strict" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Lower Precision Sin/Cos" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Enables custom sine/cosine approximations to save precision cycles." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.DxvkLowerSinCos, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="Enable Emulation" Tag="True" />
                                    <ComboBoxItem Content="Disable Emulation" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="VRAM Constant Buffers" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Enables streaming state and constants into VRAM." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.D3d9DeviceLocalConstantBuffers, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="True" Tag="True" />
                                    <ComboBoxItem Content="False" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Use FP16 Precision" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Uses FP16 for partial-precision shader instructions." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.D3d9UseFP16, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="True" Tag="True" />
                                    <ComboBoxItem Content="False" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Seamless Cubemaps" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Disables legacy d3d9 non-seamless cubemap borders to look nicer." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9SeamlessCubes, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <!-- VRAM & Memory -->
                            <TextBlock Text="VRAM &amp; Memory" FontSize="15" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Available Memory Override" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Initial tracking value in Megabytes for GetAvailableTextureMem. Recommended: 4096." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding DxvkSettings.D3d9MaxAvailableMemory, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Texture Memory Allocation" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Virtual memory budget in Megabytes for locked textures. Set to 0 to disable." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding DxvkSettings.D3d9TextureMemory, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Memory Budget Override" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Forces VRAM budget limit in Megabytes. Set to 0 to disable." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding DxvkSettings.DxvkMaxMemoryBudget, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Zero Mapped Memory" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Clears freed suballocated memory to zero. Safe fallback, but heavy CPU overhead." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.DxvkZeroMappedMemory, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Memory Tracking Testing" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Enables test parameters for internal memory allocator tracking." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9MemoryTrackTest, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Hide Integrated Graphics" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Hides iGPUs from adapter selection when dedicated GPU is present." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.DxvkHideIntegratedGraphics, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <!-- Hardware Spoofing & Custom Device ID -->
                            <TextBlock Text="Hardware Spoofing &amp; Custom Device ID" FontSize="15" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Custom Vendor ID" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Overrides PCI vendor ID (hex). E.g. Nvidia: 10de, AMD: 1002, Intel: 8086." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding DxvkSettings.D3d9CustomVendorId, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Custom Device ID" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Overrides PCI device ID (hex). E.g. 0000 to disable." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding DxvkSettings.D3d9CustomDeviceId, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Custom Device Description" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Overrides reported GPU model string shown in game settings." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding DxvkSettings.D3d9CustomDeviceDesc, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Hide Nvidia GPU" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Reports Nvidia GPU as AMD GPU to bypass bad proprietary vendor paths." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.D3d9HideNvidiaGpu, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="True" Tag="True" />
                                    <ComboBoxItem Content="False" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Hide AMD GPU" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Reports AMD GPU as Nvidia GPU to bypass AMD-specific bugs." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.D3d9HideAmdGpu, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="True" Tag="True" />
                                    <ComboBoxItem Content="False" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Hide Intel GPU" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Reports Intel GPU as AMD GPU to bypass early graphics restrictions." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.D3d9HideIntelGpu, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="True" Tag="True" />
                                    <ComboBoxItem Content="False" Tag="False" />
                                </ComboBox>
                            </ui:CardControl>

                            <!-- Legacy & Compatibility Workarounds -->
                            <TextBlock Text="Legacy &amp; Compatibility Workarounds" FontSize="15" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="UE4 Workarounds" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Enables Unreal Engine 4 HDR workarounds." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.DxgiEnableUe4Workarounds, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Support Cube Depth Formats" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Exposes obsolete cube texture depth formats. Keeps SimCity Societies from crashing." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9SupportCubeDepthFormats, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Support AMD/Intel DF formats" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Exposes DF depth textures extension on AMD/Intel drivers." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9SupportDFFormats, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Use D32 for D24" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Forces D32f depth buffer format instead of D24 to reproduce AMD issues." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9UseD32forD24, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Support X4R4G4B4 format" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Required to fix UI issues or crashes in older games like The Sims 2." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9SupportX4R4G4B4, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Disable A8 render targets" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Disables A8 texture render targets (bug workaround for Sims 2)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9DisableA8RT, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Force Sampler Type Spec Constants" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Fixes rendering in Halo: CE or Spellforce by forcing sampler spec constants." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9ForceSamplerTypeSpecConstants, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Device Lost on Focus Lost" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Triggers standard D3D9 DEVICELOST when game window loses focus." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9DeviceLossOnFocusLoss, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Count Losable Resources" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Rejects device resets if unmanaged resources are not properly freed." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9CountLosableResources, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Extra Front Buffer" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Adds extra front buffer for Silent Hill 2 Enhanced Edition compatibility." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.D3d9ExtraFrontbuffer, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <!-- Diagnostics -->
                            <TextBlock Text="Diagnostics" FontSize="15" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="DXVK HUD Overlay" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Configures performance overlay HUD. E.g. 'fps' or 'full'." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding DxvkSettings.Hud, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Hidden" Tag="" />
                                    <ComboBoxItem Content="FPS Counter Only" Tag="fps" />
                                    <ComboBoxItem Content="FPS and Compiler" Tag="fps,compiler" />
                                    <ComboBoxItem Content="Full Stats" Tag="full" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Enable Debug Utils" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Enables Vulkan user annotation debug utility markers." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding DxvkSettings.DxvkEnableDebugUtils, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Liberty's Legacy Settings Tab -->
                <Grid Visibility="{Binding IsLibertyLegacyTabActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <!-- Show warning if Liberty's Legacy settings are missing -->
                    <Grid Grid.RowSpan="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibertyLegacyConfigAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ui:Card Padding="20" Margin="0,20,15,20" MaxWidth="500" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Info24" FontSize="36" Foreground="{DynamicResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Liberty's Legacy Configuration Not Found" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                <TextBlock Text="Liberty's Legacy.ini was not found in your game directory. Please install the Liberty's Legacy Trainer first." TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:Card>
                    </Grid>

                    <ui:TextBox x:Name="LibertyLegacySearchBox" 
                                Grid.Row="0"
                                PlaceholderText="Search settings by title or description..."
                                TextChanged="LibertyLegacySearchBox_TextChanged"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Icon="{ui:SymbolIcon Search24}"
                                Margin="0,5,15,10"
                                MaxWidth="800"
                                HorizontalAlignment="Left"
                                Width="400"
                                Visibility="{Binding IsLibertyLegacyConfigAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,5,0,0">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibertyLegacyConfigAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        
                        <StackPanel x:Name="LibertyLegacySettingsStackPanel" MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,0,15,10">
                            <!-- Hotkeys & Controls -->
                            <TextBlock Text="Hotkeys &amp; Controls" FontSize="15" FontWeight="Bold" Margin="0,10,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                            
                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Menu Activation Key" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Keyboard hotkey used to toggle open the Liberty's Legacy trainer menu." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding LibertyLegacySettings.MenuKey, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="F11 (Default)" Tag="122" />
                                    <ComboBoxItem Content="F4" Tag="115" />
                                    <ComboBoxItem Content="F3" Tag="114" />
                                    <ComboBoxItem Content="F5" Tag="116" />
                                    <ComboBoxItem Content="Insert" Tag="45" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Controller Key Combo" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Allows opening the menu using gamepad button combinations (RB + D-Pad Left)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding LibertyLegacySettings.ControllerKeyCombo, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Menu Open Sound" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Plays an audible navigation sound effect when opening or closing the menu." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding LibertyLegacySettings.OpenMenuSound, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <!-- Startup Gameplay Options -->
                            <TextBlock Text="Startup Gameplay Options" FontSize="15" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="God Mode (Invincibility)" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Automatically enables player invincibility and explosion immunity upon loading into the game." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding LibertyLegacySettings.GodMode, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Never Wanted" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Disables police wanted levels permanently upon loading the game." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding LibertyLegacySettings.NeverWanted, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Infinite Ammo" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Gives infinite ammunition without reloading upon game start." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding LibertyLegacySettings.InfiniteAmmo, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <!-- Vehicles & Speedometer -->
                            <TextBlock Text="Vehicles &amp; HUD" FontSize="15" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Vehicle Speedometer" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Displays an on-screen HUD speedometer when driving vehicles." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding LibertyLegacySettings.Speedometer, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Speedometer Units" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Selects measurement unit for the vehicle speedometer overlay." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedValue="{Binding LibertyLegacySettings.SpeedometerUnit, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Miles Per Hour (MPH)" Tag="0" />
                                    <ComboBoxItem Content="Kilometers Per Hour (KM/H)" Tag="1" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Spawn Inside Vehicle" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Immediately warps the player into the driver seat when spawning a vehicle from the trainer." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding LibertyLegacySettings.VehicleSpawnInVehicle, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <!-- World & Time -->
                            <TextBlock Text="World &amp; Environment" FontSize="15" FontWeight="Bold" Margin="0,15,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Freeze Weather" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Prevents game weather cycles from changing dynamically." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding LibertyLegacySettings.FreezeWeather, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Freeze Time" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Locks the in-game clock to prevent the day/night cycle from advancing." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding LibertyLegacySettings.FreezeTime, Mode=TwoWay}" VerticalAlignment="Center" />
                            </ui:CardControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </Grid>

                <!-- Actions Footer bar -->
                <ui:Card Grid.Row="2" Margin="0,10,0,0" Padding="12" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Tuning modifications are saved directly into your game files." 
                                   VerticalAlignment="Center" 
                                   FontSize="11" 
                                   TextWrapping="Wrap"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Refresh" 
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Command="{Binding RefreshFusionFixConfigCommand}"
                                       Style="{StaticResource SecondaryFooterButtonStyle}" />
                            <ui:Button Content="Defaults" 
                                       Icon="{ui:SymbolIcon ArrowReset24}"
                                       Command="{Binding LoadFusionFixDefaultsCommand}"
                                       Visibility="{Binding IsBackendConfigAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Style="{StaticResource SecondaryFooterButtonStyle}" />
                            <ui:Button Content="Save Configuration" 
                                       Icon="{ui:SymbolIcon Save24}"
                                       Command="{Binding SaveFusionFixConfigCommand}"
                                       Style="{StaticResource PrimaryFooterButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>