                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Minigames FPS Limit" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Locks framerate during minigames to prevent physics bugs." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.MinigamesFpsLimit, Mode=TwoWay}" Width="100" VerticalAlignment="Center" TextAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Affected Minigames List" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Identifiers of games locked to the limit parameter." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.MinigamesList, Mode=TwoWay}" Width="250" VerticalAlignment="Center" />
                                </ui:CardControl>

