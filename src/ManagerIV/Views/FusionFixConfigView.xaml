<UserControl x:Class="ManagerIV.Views.FusionFixConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ManagerIV.Views"
             xmlns:core="clr-namespace:ManagerIV.Core"
             xmlns:controls="clr-namespace:ManagerIV.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850"
             TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#B0FFFFFF" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <core:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <core:LessThanConverter x:Key="LessThanConverter" />

        <!-- Segmented Tab RadioButton Style -->
        <Style x:Key="SegmentTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MutedAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryFooterButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource LessThanConverter}, ConverterParameter=900}" Value="True">
                    <Setter Property="Width" Value="105" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="4,2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryFooterButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Appearance" Value="Primary" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource LessThanConverter}, ConverterParameter=900}" Value="True">
                    <Setter Property="Width" Value="145" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="4,2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Backend Configuration" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Configure FusionFix and DXVK settings saved in your Grand Theft Auto IV game directory." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            
            <!-- Placeholder Card (Visible when Backend Config is NOT installed/available) -->
            <ui:Card Padding="25" 
                      VerticalAlignment="Center" 
                      HorizontalAlignment="Center" 
                      MaxWidth="500"
                      Visibility="{Binding IsBackendConfigAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Wrench24" Filled="True" FontSize="48" Foreground="{DynamicResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" Margin="0,0,0,15" />
                    <TextBlock Text="Backend Setup Needed" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Neither GTAIV.EFLC.FusionFix.ini nor dxvk.conf were found in your game directory. Please install FusionFix or DXVK first." 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               FontSize="13" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               Margin="0,0,0,20" />
                </StackPanel>
            </ui:Card>

            <!-- Configuration Form (Visible when Backend Config IS installed/available) -->
            <Grid Visibility="{Binding IsBackendConfigAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Sub-tab buttons -->
                    <RowDefinition Height="*" />    <!-- Content area -->
                    <RowDefinition Height="Auto" /> <!-- Actions footer -->
                </Grid.RowDefinitions>

                <!-- Sub-Tab Segmented Control Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="3" 
                        HorizontalAlignment="Left" 
                        Margin="0,0,0,15">
                    <WrapPanel>
                        <RadioButton IsChecked="{Binding IsFusionFixTabActive, Mode=TwoWay}" 
                                     GroupName="BackendSubTabs" 
                                     Style="{StaticResource SegmentTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Options24" Filled="True" Margin="0,0,8,0" />
                                <TextBlock Text="FusionFix" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton IsChecked="{Binding IsDxvkTabActive, Mode=TwoWay}" 
                                     GroupName="BackendSubTabs" 
                                     Style="{StaticResource SegmentTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop24" Filled="True" Margin="0,0,8,0" />
                                <TextBlock Text="DXVK" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton IsChecked="{Binding IsLibertyLegacyTabActive, Mode=TwoWay}" 
                                     GroupName="BackendSubTabs" 
                                     Style="{StaticResource SegmentTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="WindowDevTools24" Filled="True" Margin="0,0,8,0" />
                                <TextBlock Text="Liberty's Legacy" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Row="1">
                    <!-- FusionFix Tab Panel -->
                    <Grid Visibility="{Binding IsFusionFixTabActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <!-- Show warning if FusionFix settings are missing -->
                        <Grid Grid.RowSpan="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFusionFixConfigAvailable}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ui:Card Padding="20" Margin="0,20,15,20" MaxWidth="500" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Info24" FontSize="36" Foreground="{DynamicResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Text="FusionFix Configuration Not Found" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                    <TextBlock Text="GTAIV.EFLC.FusionFix.ini was not found in your plugins directory. Please install FusionFix first." TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:Card>
                        </Grid>

                        <Grid Grid.Row="0" Grid.RowSpan="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFusionFixConfigAvailable}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                    <ui:TextBox x:Name="SearchBox" 
                                Grid.Row="0"
                                PlaceholderText="Search settings by title or description..."
                                TextChanged="SearchBox_TextChanged"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Icon="{ui:SymbolIcon Search24}"
                                Margin="0,5,15,10"
                                MaxWidth="800"
                                HorizontalAlignment="Left"
                                Width="400" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,5,0,0">
                        <StackPanel x:Name="SettingsStackPanel" MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,0,15,10">
                                <TextBlock Text="Gameplay Mechanics" FontSize="15" FontWeight="Bold" Margin="0,10,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Recoil Fix (Mouse/KB)" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Applies controller-style recoil steering bias when playing with keyboard and mouse." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.RecoilFixEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Aiming Zoom Fix" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Specifies desaturated aiming zoom settings across game episodes." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox SelectedValue="{Binding FusionFixSettings.AimingZoomFix, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Disabled" Tag="0" />
                                        <ComboBoxItem Content="Xbox Parity (TBoGT only)" Tag="1" />
                                        <ComboBoxItem Content="Global (IV, TLaD, and TBoGT)" Tag="2" />
                                        <ComboBoxItem Content="Legacy (TBoGT zoom like IV)" Tag="-1" />
                                    </ComboBox>
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Skip Intro Cutscenes" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Skips the startup logo videos to load the game faster." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.SkipIntroEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Skip Main Menu" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Bypasses the main menu and loads directly into the last save game." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.SkipMenuEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Mouse Input Fix" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Improves mouse aiming and fixes sensitivity bugs on modern systems." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.MouseFixEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Walk Key Bind" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Click to assign a key or mouse button for walking toggle (or clear to unbind)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <controls:KeyBindPicker KeyHexCode="{Binding FusionFixSettings.WalkKey, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <TextBlock Text="Camera Sensitivity Ranges" FontSize="15" FontWeight="Bold" Margin="0,5,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                <ui:Card Margin="0,0,0,8" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Header Row -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Camera Slider Option" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Min Range" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,0,5" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Max Range" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,0,5" HorizontalAlignment="Center" />

                                        <!-- Mouse Look -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mouse Look Sensitivity" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FusionFixSettings.MouseLookSensitivityRangeMin, Mode=TwoWay}" Margin="5,4" TextAlignment="Center"/>
                                        <ui:TextBox Grid.Row="1" Grid.Column="2" Text="{Binding FusionFixSettings.MouseLookSensitivityRangeMax, Mode=TwoWay}" Margin="5,4" TextAlignment="Center"/>

                                        <!-- Gamepad Look -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Gamepad Look Sensitivity" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FusionFixSettings.GamepadLookSensitivityRangeMin, Mode=TwoWay}" Margin="5,4" TextAlignment="Center"/>
                                        <ui:TextBox Grid.Row="2" Grid.Column="2" Text="{Binding FusionFixSettings.GamepadLookSensitivityRangeMax, Mode=TwoWay}" Margin="5,4" TextAlignment="Center"/>

                                        <!-- Mouse Aim -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Mouse Aim Sensitivity" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ui:TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FusionFixSettings.MouseAimSensitivityRangeMin, Mode=TwoWay}" Margin="5,4" TextAlignment="Center"/>
                                        <ui:TextBox Grid.Row="3" Grid.Column="2" Text="{Binding FusionFixSettings.MouseAimSensitivityRangeMax, Mode=TwoWay}" Margin="5,4" TextAlignment="Center"/>
                                    </Grid>
                                </ui:Card>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Gamepad Aim Sensitivity Range" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Specifies min and max sensitivity range values for controller aiming." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:TextBox Text="{Binding FusionFixSettings.GamepadAimSensitivityRangeMin, Mode=TwoWay}" Width="80" Margin="0,0,5,0" TextAlignment="Center"/>
                                        <ui:TextBox Text="{Binding FusionFixSettings.GamepadAimSensitivityRangeMax, Mode=TwoWay}" Width="80" TextAlignment="Center"/>
                                    </StackPanel>
                                </ui:CardControl>

                                <TextBlock Text="Shadow Map Configuration" FontSize="15" FontWeight="Bold" Margin="0,20,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="High Resolution Shadows" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Doubles cascaded shadow map resolution. Very GPU intensive." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.HighResolutionShadowsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Extra Dynamic Shadows" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Adds missing shadows back to vegetation, grates, and fences." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox SelectedValue="{Binding FusionFixSettings.ExtraDynamicShadows, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Disabled (Vanilla shadows)" Tag="0" />
                                        <ComboBoxItem Content="Vegetation Only" Tag="1" />
                                        <ComboBoxItem Content="Full Environment" Tag="2" />
                                    </ComboBox>
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Cascade Blend Size" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Controls the blending range region between cascades [0.0; 1.0]." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.CascadeBlendSize, Mode=TwoWay}" Width="100" VerticalAlignment="Center" TextAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Force Shadow Filter" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Forces shadow blur quality profile parameters." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox SelectedValue="{Binding FusionFixSettings.ForceShadowFilter, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Tied to definition (0)" Tag="0" />
                                        <ComboBoxItem Content="Force Low Quality (1)" Tag="1" />
                                        <ComboBoxItem Content="Force High Quality (2)" Tag="2" />
                                    </ComboBox>
                                </ui:CardControl>

                                <TextBlock Text="Shadow Filter Tuning (Sharp, Soft &amp; CHSS)" FontSize="15" FontWeight="Bold" Margin="0,5,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                <ui:Card Margin="0,0,0,8" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Headers -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Filter Profile" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Softness" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Bias" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Max Softness" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />

                                        <!-- Sharp -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sharp Shadows (CE-like)" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FusionFixSettings.SharpShadowSoftness, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                        <ui:TextBox Grid.Row="1" Grid.Column="2" Text="{Binding FusionFixSettings.SharpShadowBias, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="N/A" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorDisabledBrush}" />

                                        <!-- Soft -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Soft Shadows (1.0.4.0-like)" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FusionFixSettings.SoftShadowSoftness, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                        <ui:TextBox Grid.Row="2" Grid.Column="2" Text="{Binding FusionFixSettings.SoftShadowBias, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="N/A" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorDisabledBrush}" />

                                        <!-- CHSS -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="CHSS Shadows (PCSS)" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ui:TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FusionFixSettings.ChssShadowSoftness, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                        <ui:TextBox Grid.Row="3" Grid.Column="2" Text="{Binding FusionFixSettings.ChssShadowBias, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                        <ui:TextBox Grid.Row="3" Grid.Column="3" Text="{Binding FusionFixSettings.ChssMaxSoftness, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                    </Grid>
                                </ui:Card>

                                <TextBlock Text="Volumetric Fog &amp; Sky" FontSize="15" FontWeight="Bold" Margin="0,5,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Volumetric Fog Far Clip" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Overrides rendering limit clip for volumetric fog (Default: 4500.0)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.VolFogFarClip, Mode=TwoWay}" Width="100" VerticalAlignment="Center" TextAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Extended Timecycle Editing" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Enables dynamic editing of timecycle modifiers in-game by pressing F3." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.ExtendedTimecycEditingEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <TextBlock Text="Ambient Occlusion &amp; Transparency" FontSize="15" FontWeight="Bold" Margin="0,20,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Pre-Alpha Depth Pass" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Enables post-processing depth (e.g. DOF, sunshafts) through transparent objects." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.EnablePreAlphaDepthEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:Card Margin="0,0,0,15" Padding="15">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Header -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="AO Parameter" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Samples" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Blur Passes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Blur Radius" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ambient Occlusion Details" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FusionFixSettings.AmbientOcclusionSamples, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                            <ui:TextBox Grid.Row="1" Grid.Column="2" Text="{Binding FusionFixSettings.AmbientOcclusionBlurPasses, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                            <ui:TextBox Grid.Row="1" Grid.Column="3" Text="{Binding FusionFixSettings.AmbientOcclusionBlurRadius, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />

                                            <!-- Radius, Bias, Intensity -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="AO Radius / Bias / Intensity" FontSize="13" VerticalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FusionFixSettings.AmbientOcclusionRadius, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                            <ui:TextBox Grid.Row="2" Grid.Column="2" Text="{Binding FusionFixSettings.AmbientOcclusionBias, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                            <ui:TextBox Grid.Row="2" Grid.Column="3" Text="{Binding FusionFixSettings.AmbientOcclusionIntensity, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                        </Grid>

                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,6" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="AO Log Offset / Far Clip / Max Mip Level" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <ui:TextBox Grid.Column="1" Text="{Binding FusionFixSettings.AmbientOcclusionLogMaxOffset, Mode=TwoWay}" Margin="5,0" TextAlignment="Center" ToolTip="Log Max Offset" />
                                            <ui:TextBox Grid.Column="2" Text="{Binding FusionFixSettings.AmbientOcclusionFarClip, Mode=TwoWay}" Margin="5,0" TextAlignment="Center" ToolTip="Far Clip" />
                                            <ui:TextBox Grid.Column="3" Text="{Binding FusionFixSettings.AmbientOcclusionSourceMaxMipLevel, Mode=TwoWay, FallbackValue='0'}" Margin="5,0" TextAlignment="Center" ToolTip="Max Mip Level" />
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <TextBlock Text="Sun Shafts (God Rays)" FontSize="15" FontWeight="Bold" Margin="0,5,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                
                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Sunshafts Intensity" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Adjust Density (length) and Decay (fade out rate) parameters." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:TextBox Text="{Binding FusionFixSettings.SunShaftsDensity, Mode=TwoWay}" Width="100" Margin="0,0,5,0" TextAlignment="Center" ToolTip="Density" />
                                        <ui:TextBox Text="{Binding FusionFixSettings.SunShaftsDecay, Mode=TwoWay}" Width="100" TextAlignment="Center" ToolTip="Decay" />
                                    </StackPanel>
                                </ui:CardControl>

                                <TextBlock Text="Project 2DFX (Corona Light Rings)" FontSize="15" FontWeight="Bold" Margin="0,5,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Corona Multipliers" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Scale Radius and Opacity Alpha values for light halos." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:TextBox Text="{Binding FusionFixSettings.CoronaRadiusMultiplier, Mode=TwoWay}" Width="100" Margin="0,0,5,0" TextAlignment="Center" ToolTip="Radius Multiplier" />
                                        <ui:TextBox Text="{Binding FusionFixSettings.CoronaAlphaMultiplier, Mode=TwoWay}" Width="100" TextAlignment="Center" ToolTip="Alpha Multiplier" />
                                    </StackPanel>
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Increase Corona Radius with Distance" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Dynamically scales halo lights size when located far away." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.SlightlyIncreaseRadiusWithDistanceEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Disable Default LOD Distant Lights" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Overrides standard distant streetlamps in favor of modded lights." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.DisableDefaultLodLightsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <TextBlock Text="Console Parity Features" FontSize="15" FontWeight="Bold" Margin="0,20,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Console Reflections and Dirt" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Restores specular car paint shaders and randomly spawns dirty vehicles." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.ConsoleCarReflectionsAndDirtEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Restored Death Music" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Restores the cut themes that play when the player is wasted in GTA IV." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.DeathMusicEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Default Camera Angle in TLaD" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Enforces default GTA IV camera orientation on bikes in Lost &amp; Damned." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.DefaultCameraAngleInTLaDEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Pedestrian Death Anim Fix (TBoGT)" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Disables double counter-attack death loops for peds in IV and TLaD." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.PedDeathAnimFixFromTBoGTEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Disable Camera Centering in Cover" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Prevents camera snaps when aiming near wall corners in cover." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.DisableCameraCenteringInCoverEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Show Health on Reticle (Mouse/KB)" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Always shows target health circles around the cursor reticle." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.AlwaysDisplayHealthOnReticleEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <TextBlock Text="Graphics Parity Adjustments" FontSize="15" FontWeight="Bold" Margin="0,5,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Smooth Shorelines" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Applies foam noise blending to eliminate sharp water edges." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.SmoothShorelinesEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Smooth Light Volumes" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Implements custom light volumetric edge smoothing parameters." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.SmoothLightVolumesEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Prevent Bloom Color Shift" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Fixes high luminance values turning blue or magenta with tone mapping." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.NoBloomColorShiftEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <TextBlock Text="Drunk Driving Fix Modifiers" FontSize="15" FontWeight="Bold" Margin="0,5,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Handling Physics Fix Intensity" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Subtracts FPS steering bias. Standard value is 0.65." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal" Width="250">
                                        <Slider Minimum="0.0" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding FusionFixSettings.DrunkDrivingHandlingFixIntensity, Mode=TwoWay}" Width="180" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FusionFixSettings.DrunkDrivingHandlingFixIntensity, StringFormat='\{0:0.00\}'}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Camera Shake Frequency Fix Intensity" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Scales shake frequency step to prevent intense shaking at high FPS." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal" Width="250">
                                        <Slider Minimum="0.0" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding FusionFixSettings.DrunkDrivingCamFixIntensity, Mode=TwoWay}" Width="180" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FusionFixSettings.DrunkDrivingCamFixIntensity, StringFormat='\{0:0.00\}'}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl>

                                <TextBlock Text="Delay Timers &amp; Information" FontSize="15" FontWeight="Bold" Margin="0,5,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                <ui:Card Margin="0,0,0,8" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Delay Setting (ms)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Menu Enter" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Menu Exit" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Menu Startup" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="UI Delay Timers" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FusionFixSettings.MenuEnteringDelay, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                        <ui:TextBox Grid.Row="1" Grid.Column="2" Text="{Binding FusionFixSettings.MenuExitingDelay, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                        <ui:TextBox Grid.Row="1" Grid.Column="3" Text="{Binding FusionFixSettings.MenuAccessDelayOnStartup, Mode=TwoWay}" Margin="5,4" TextAlignment="Center" />
                                    </Grid>
                                </ui:Card>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Radar Zoom Scale Delay" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Delays radar zoom calculations inside vehicles (Default: 3000 ms)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.RadarZoomDelay, Mode=TwoWay}" Width="100" VerticalAlignment="Center" TextAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Menu Extra Info" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Displays advanced configuration metadata lists in the pause menu." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.ExtraInfoEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,15">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Tree Opacity Alpha Override" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Custom alpha values for trees (e.g. 0.625 for PC, 2.5 for PS3, 4.0 for Xbox)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.OverrideTreeAlpha, Mode=TwoWay}" Width="100" VerticalAlignment="Center" TextAlignment="Center" />
                                </ui:CardControl>

                                <TextBlock Text="Frame Limiter Engine" FontSize="15" FontWeight="Bold" Margin="0,20,0,8" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Frame Limit Method" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Realtime (Thread-Lock) or Sleep-Yield (Accurate, saves CPU resources)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox SelectedValue="{Binding FusionFixSettings.FrameLimitType, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Thread-Lock Realtime (1)" Tag="1" />
                                        <ComboBoxItem Content="Sleep-Yield Accurate (2)" Tag="2" />
                                    </ComboBox>
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Gameplay FPS Limit" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Framerate lock parameter (-2 for refresh rate, -1 disabled)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.FpsLimit, Mode=TwoWay}" Width="100" VerticalAlignment="Center" TextAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Cutscenes Framerate Ceiling" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Limits framerate only during cutscenes to prevent zoom glitches (0 disabled)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.CutsceneFpsLimit, Mode=TwoWay}" Width="100" VerticalAlignment="Center" TextAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Loading Screen Cap" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Standard cap to prevent loading freeze bugs (Recommended: 30 FPS)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.LoadingFpsLimit, Mode=TwoWay}" Width="100" VerticalAlignment="Center" TextAlignment="Center" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Unlock Framerate During Loads" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Unlocks the frame ceiling during loads to load textures significantly faster." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch IsChecked="{Binding FusionFixSettings.UnlockFramerateDuringLoadscreensEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </ui:CardControl>

