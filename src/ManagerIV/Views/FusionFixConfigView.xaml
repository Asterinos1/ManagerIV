                                            <TextBlock Text="Custom User Profile Path" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Redirects save games and user settings directory to a custom path (Leave blank for default)." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:TextBox Text="{Binding FusionFixSettings.CustomUserProfilePath, Mode=TwoWay}" Width="250" VerticalAlignment="Center" PlaceholderText="e.g. C:\MySaves" />
                                </ui:CardControl>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>

                <!-- Actions Footer bar -->
                <ui:Card Grid.Row="1" Margin="0,10,0,0" Padding="12" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                    <Grid>
                        <TextBlock Text="Tuning modifications are saved directly into the active profile's plugins directory." 
                                   VerticalAlignment="Center" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Defaults" 
                                       Icon="{ui:SymbolIcon ArrowReset24}"
                                       Command="{Binding LoadFusionFixDefaultsCommand}"
                                       Margin="0,0,10,0"
                                       Width="140" 
                                       Height="36" />
                            <ui:Button Content="Save Configuration" 
                                       Icon="{ui:SymbolIcon Save24}"
                                       Command="{Binding SaveFusionFixConfigCommand}"
                                       Appearance="Primary"
                                       Width="180" 
                                       Height="36" />
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>