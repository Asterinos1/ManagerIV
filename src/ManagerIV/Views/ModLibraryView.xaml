<UserControl x:Class="ManagerIV.Views.ModLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ManagerIV.Views"
             xmlns:vm="clr-namespace:ManagerIV.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             AllowDrop="True"
             Drop="UserControl_Drop"
             DragOver="UserControl_DragOver"
             DragEnter="UserControl_DragEnter"
             DragLeave="UserControl_DragLeave"
             SizeChanged="UserControl_SizeChanged"
             Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:SeverityToInfoBarSeverityConverter x:Key="SeverityToInfoBarSeverityConverter" />
        <Storyboard x:Key="MarchingAnts">
            <DoubleAnimation Storyboard.TargetName="DashedBorder" 
                             Storyboard.TargetProperty="StrokeDashOffset" 
                             From="0" To="12" 
                             Duration="0:0:1" 
                             RepeatBehavior="Forever" />
        </Storyboard>
        <Storyboard x:Key="FadeInOverlay">
            <DoubleAnimation Storyboard.TargetName="DragOverOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.25" />
        </Storyboard>

        <DataTemplate x:Key="ModItemTemplate" DataType="{x:Type vm:ModViewModel}">
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="6,4" Margin="0" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />  <!-- Priority / Enable Checkbox -->
                        <ColumnDefinition Width="*" />     <!-- Mod Info -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Priority Indicator and Toggle Checkbox -->
                    <StackPanel Grid.RowSpan="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Priority, StringFormat='\{0:D3\}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Width="25" VerticalAlignment="Center" TextAlignment="Center" />
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding DataContext.ToggleModEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="6,0,6,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Mod Name & Version -->
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                    <!-- Tags -->
                    <WrapPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Version, StringFormat='Version: \{0\}'}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ConflictStatus}" ToolTip="{Binding ConflictDetails}" FontSize="10" FontWeight="SemiBold" Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConflictStatus}" Value="❌ Structure Error">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Type Tag (Asset, ASI, Script) -->
                        <Border x:Name="TypeTagBorder" CornerRadius="3" Padding="4,1" Margin="0,1,4,1" VerticalAlignment="Center">
                            <TextBlock x:Name="TypeTagText" FontSize="9" FontWeight="Bold" Foreground="White" />
                        </Border>

                        <Border x:Name="CompatBorder" CornerRadius="3" Padding="4,1" Margin="0,1,4,1" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <TextBlock Text="{Binding Compatibility}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>

                        <!-- Custom Tags (e.g. FusionOverloader, mixed) -->
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="4,1" Margin="0,1,4,1" VerticalAlignment="Center" Background="{DynamicResource SystemAccentColorSecondaryBrush}">
                                        <TextBlock Text="{Binding}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Map Target tags -->
                <DataTrigger Binding="{Binding TypeTag}" Value="Update">
                    <Setter TargetName="TypeTagBorder" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="TypeTagText" Property="Text" Value="ASSET" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeTag}" Value="Plugins">
                    <Setter TargetName="TypeTagBorder" Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                    <Setter TargetName="TypeTagText" Property="Text" Value="ASI" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeTag}" Value="Scripts">
                    <Setter TargetName="TypeTagBorder" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="TypeTagText" Property="Text" Value="SCRIPT" />
                </DataTrigger>

                <!-- Highlight compatibility status -->
                <DataTrigger Binding="{Binding Compatibility}" Value="CE-compatible">
                    <Setter TargetName="CompatBorder" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Compatibility}" Value="Legacy">
                    <Setter TargetName="CompatBorder" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Compatibility}" Value="Mixed">
                    <Setter TargetName="CompatBorder" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid x:Name="RootGrid">
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header and drag-and-drop info -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Mod Library" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Drag and drop mod files (.asi) or archives (.zip, .rar, .7z) here to import them." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            
            <StackPanel x:Name="HeaderActionsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon Delete24}" 
                           Content="Clear Library" 
                           Command="{Binding ClearLibraryCommand}"
                           Appearance="Danger"
                           Margin="0,0,10,0" />
                <ui:Button Icon="{ui:SymbolIcon FolderAdd24}" 
                           Content="Import Mod" 
                           Command="{Binding ImportModArchiveCommand}" />
            </StackPanel>
        </Grid>

        <!-- .img Archives Limit Counter -->
        <ui:Card Grid.Row="1" Margin="0,0,0,15" Padding="15" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Top row: Info and Current count -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <WrapPanel Grid.Column="0">
                        <ui:SymbolIcon Symbol="Database24" Filled="True" Margin="0,0,8,0" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Warning">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Danger">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock Text="Active Custom .IMG Archives:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text=" " />
                        <TextBlock Text="{Binding ActiveImgArchiveStatus}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Warning">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Danger">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveImgArchiveCount}" FontSize="15" FontWeight="Black" />
                        <TextBlock Text=" / 50 limit" FontSize="11" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,0,0,2" />
                    </StackPanel>
                </Grid>
                
                <!-- Progress Bar -->
                <ProgressBar Grid.Row="1" Height="8" Minimum="0" Maximum="50" Value="{Binding ActiveImgArchiveCount}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Warning">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Danger">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                
                <!-- Warning description box (visible when warning or danger) -->
                <ui:InfoBar Grid.Row="2" 
                            Margin="0,10,0,0"
                            Title="{Binding ActiveImgArchiveWarningTitle}"
                            Message="{Binding ActiveImgArchiveWarningDescription}"
                            IsOpen="{Binding ActiveImgArchiveHasWarning}"
                            Severity="{Binding ActiveImgArchiveSeverity, Converter={StaticResource SeverityToInfoBarSeverityConverter}}" />
            </Grid>
        </ui:Card>

        <!-- Library List with Drag-and-Drop Reordering -->
        <Grid x:Name="LibraryContentGrid" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ListsContainerGrid" Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:Card x:Name="LibraryListCard" Grid.Row="0" Margin="0,0,0,4" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="12,12,12,8">
                            <TextBlock Text="Mod library (Assets &amp; Scripts)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Note: Every mod will be placed higher than the FusionFix folder in the update folder." FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />
                            <ui:TextBox Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Search mods &amp; plugins..."
                                        Icon="{ui:SymbolIcon Search24}" />
                        </StackPanel>
                        
                        <ListBox Grid.Row="1" x:Name="LibraryListBox" ItemsSource="{Binding MainModsCollection}"
                                 SelectedItem="{Binding SelectedLibraryMod, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource ModItemTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                 MouseMove="ListBox_MouseMove"
                                 DragOver="ListBox_DragOver"
                                 Drop="ListBox_Drop"
                                 AllowDrop="True"
                                 Background="Transparent"
                                 BorderThickness="0" />
                    </Grid>
                </ui:Card>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Margin="0,4" />

                <ui:Card x:Name="PluginsListCard" Grid.Row="2" Margin="0,4,0,0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="12,12,12,8">
                            <TextBlock Text="Plugins List (.ASI)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Note: ASI plugins are loaded alphabetically. Change their priority to control load order." FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        
                        <ListBox Grid.Row="1" x:Name="PluginsListBox" ItemsSource="{Binding PluginsCollection}"
                                 SelectedItem="{Binding SelectedPluginMod, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource ModItemTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                 MouseMove="ListBox_MouseMove"
                                 DragOver="ListBox_DragOver"
                                 Drop="ListBox_Drop"
                                 AllowDrop="True"
                                 Background="Transparent"
                                 BorderThickness="0" />
                    </Grid>
                </ui:Card>
            </Grid>

            <Grid x:Name="RightPanelGrid" Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Database24" Margin="0,0,6,0" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Merged update files" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ActiveMergedUpdateFileCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding ActiveMergedUpdateFiles}" MaxHeight="150" Background="Transparent" BorderThickness="0" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" Background="{DynamicResource SystemFillColorSuccessBrush}">
                                            <TextBlock Text="{Binding Root}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding RelativePath}" FontSize="10" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ModName}" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ui:Card>

                <!-- Inspector panel for selected Mod details -->
                <ui:Card x:Name="InspectorCard" Grid.Row="1" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <!-- Placeholder when null -->
                        <TextBlock Text="Select a mod to edit details." 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMod}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Details Editor when NOT null -->
                        <Grid DataContext="{Binding SelectedMod}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.SelectedMod, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Mod Details" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                    <TextBlock Text="Name" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,1" />
                                    <ui:TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" />

                                    <TextBlock Text="Version" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,1" />
                                    <ui:TextBox Text="{Binding Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" />

                                    <TextBlock Text="Compatibility" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,1" />
                                    <ui:TextBox Text="{Binding Compatibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" />

                                    <TextBlock Text="Tags / Notes" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,1" />
                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,0,0,5">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="3" Padding="5,1" Margin="0,1,5,1" Background="{DynamicResource SystemAccentColorSecondaryBrush}">
                                                    <TextBlock Text="{Binding}" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Description" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,1" />
                                    <ui:TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                AcceptsReturn="True" 
                                                TextWrapping="Wrap" 
                                                MinLines="2" 
                                                Margin="0,0,0,5" />

                                    <TextBlock Text="File Layout" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,1" />
                                    <ListBox ItemsSource="{Binding Model.Files}" MaxHeight="80" Background="Transparent" BorderThickness="0" VirtualizingPanel.ScrollUnit="Pixel" Margin="0,0,0,5">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <ui:SymbolIcon Symbol="Document24" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="12" />
                                                    <TextBlock Text="{Binding RelativePath}" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Action Buttons at the bottom -->
                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <ui:Button Grid.Column="0"
                                           Content="Delete" 
                                           Icon="{ui:SymbolIcon Delete24}" 
                                           Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           CommandParameter="{Binding}"
                                           Appearance="Danger" 
                                           HorizontalAlignment="Left" />
                                           
                                <ui:Button Grid.Column="1" 
                                           Content="Save" 
                                           Icon="{ui:SymbolIcon Save24}" 
                                           Command="{Binding DataContext.SaveModDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           Appearance="Primary" 
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>

        <Grid x:Name="DragOverOverlay" 
              Visibility="Collapsed" 
              Opacity="0"
              IsHitTestVisible="True"
              AllowDrop="True">
            <!-- Semi-transparent backdrop blur overlay -->
            <Border Background="#90000000" CornerRadius="8" />
            
            <Grid Margin="15">
                <!-- Glowing/Animated Border Shape -->
                <Rectangle x:Name="DashedBorder"
                           Stroke="{DynamicResource SystemAccentColorSecondaryBrush}" 
                           StrokeThickness="3" 
                           StrokeDashArray="4 2" 
                           RadiusX="8" RadiusY="8"
                           Fill="#EE1E1E1E">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="{DynamicResource SystemAccentColorSecondary}" BlurRadius="25" ShadowDepth="0" Opacity="0.55" />
                    </Rectangle.Effect>
                </Rectangle>
                
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderAdd48" Filled="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" FontSize="56" Margin="0,0,0,16" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop Mods or Archives here to import" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="Supports .zip, .rar, .7z archives and .asi files" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
