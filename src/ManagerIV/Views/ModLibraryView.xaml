<UserControl x:Class="ManagerIV.Views.ModLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ManagerIV.Views"
             xmlns:vm="clr-namespace:ManagerIV.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             AllowDrop="True"
             Drop="UserControl_Drop"
             DragOver="UserControl_DragOver"
             DragEnter="UserControl_DragEnter"
             DragLeave="UserControl_DragLeave"
             SizeChanged="UserControl_SizeChanged"
             Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <UserControl.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding ImportModArchiveCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="CleanListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Segmented Tab RadioButton Style -->
        <Style x:Key="SegmentTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MutedAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:SeverityToInfoBarSeverityConverter x:Key="SeverityToInfoBarSeverityConverter" />
        <Storyboard x:Key="MarchingAnts">
            <DoubleAnimation Storyboard.TargetName="DashedBorder" 
                             Storyboard.TargetProperty="StrokeDashOffset" 
                             From="0" To="12" 
                             Duration="0:0:1" 
                             RepeatBehavior="Forever" />
        </Storyboard>
        <Storyboard x:Key="FadeInOverlay">
            <DoubleAnimation Storyboard.TargetName="DragOverOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.25" />
        </Storyboard>

        <DataTemplate x:Key="ModItemTemplate" DataType="{x:Type vm:ModViewModel}">
            <Border BorderThickness="1" 
                    CornerRadius="6"
                    Padding="6,6" 
                    Margin="4,2,8,4" 
                    HorizontalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />  <!-- Drag Handle & Checkbox -->
                        <ColumnDefinition Width="*" />     <!-- Mod Info -->
                        <ColumnDefinition Width="Auto" />  <!-- Edit Button -->
                        <ColumnDefinition Width="Auto" />  <!-- Trash Button -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Priority Indicator and Toggle Checkbox -->
                    <StackPanel Grid.RowSpan="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ReOrderDotsVertical24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="18" Margin="0,0,4,0" Cursor="SizeAll" />
                        <TextBlock Text="{Binding Priority, StringFormat='\{0:D3\}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Width="25" VerticalAlignment="Center" TextAlignment="Center" />
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding DataContext.ToggleModEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="6,0,6,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Mod Name & Version -->
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                    <!-- Tags -->
                    <WrapPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Version, StringFormat='Version: \{0\}'}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ConflictStatus}" ToolTip="{Binding ConflictDetails}" FontSize="10" FontWeight="SemiBold" Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConflictStatus}" Value="❌ Structure Error">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Type Tag (Asset, ASI, Script): neutral chip. Colour is reserved for the
                             Compatibility tag so the two stop sharing hues in the same row. -->
                        <Border x:Name="TypeTagBorder" CornerRadius="3" Padding="6,1" Margin="0,1,4,1" VerticalAlignment="Center" Background="{DynamicResource MutedAccentBrush}">
                            <TextBlock x:Name="TypeTagText" Text="{Binding TargetDisplayName}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                        </Border>

                        <Border x:Name="CompatBorder" CornerRadius="3" Padding="4,1" Margin="0,1,4,1" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <TextBlock x:Name="CompatText" Text="{Binding Compatibility}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>

                        <!-- Custom Tags (e.g. FusionOverloader, mixed) -->
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CustomTagBorder" CornerRadius="3" Padding="4,1" Margin="0,1,4,1" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                        <TextBlock x:Name="CustomTagText" Text="{Binding}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <!-- Edit Button -->
                    <ui:Button Grid.Column="2" Grid.RowSpan="2"
                               Icon="{ui:SymbolIcon Edit24}"
                               Command="{Binding DataContext.LibraryVM.OpenEditModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               Appearance="Transparent"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Padding="4" 
                               Margin="4,0,4,0" 
                               Width="28" Height="28" 
                               ToolTip="Edit Mod Details" 
                               AutomationProperties.Name="Edit Mod Details" />
 
                    <!-- Trash Button -->
                    <ui:Button Grid.Column="3" Grid.RowSpan="2"
                               Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               Appearance="Transparent"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Padding="4" 
                               Margin="4,0,8,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" 
                               ToolTip="Delete Mod" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Map Target tags: label only, neutral chip (see TypeTagBorder) -->
                <DataTrigger Binding="{Binding TypeTag}" Value="Update">
                    <Setter TargetName="TypeTagText" Property="Text" Value="ASSET" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeTag}" Value="Plugins">
                    <Setter TargetName="TypeTagText" Property="Text" Value="ASI" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeTag}" Value="Scripts">
                    <Setter TargetName="TypeTagText" Property="Text" Value="SCRIPT" />
                </DataTrigger>

                <!-- Highlight compatibility status. Foreground set per-state for contrast:
                     dark text on the light caution amber, white on green/red. -->
                <DataTrigger Binding="{Binding Compatibility}" Value="CE-compatible">
                    <Setter TargetName="CompatBorder" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="CompatText" Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Compatibility}" Value="Legacy">
                    <Setter TargetName="CompatBorder" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="CompatText" Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Compatibility}" Value="Mixed">
                    <Setter TargetName="CompatBorder" Property="Background" Value="{DynamicResource MutedAccentBrush}" />
                    <Setter TargetName="CompatText" Property="Foreground" Value="{DynamicResource WarningTagTextBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20" MinWidth="400" MinHeight="500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- Header and drag-and-drop info -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,0">
                <TextBlock Text="Mod Library" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Drag and drop mod files (.asi) or archives (.zip, .rar, .7z) here to import them." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            
            <StackPanel x:Name="HeaderActionsPanel" Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon FolderAdd24}" 
                           Content="Import Mod" 
                           AutomationProperties.Name="Import Mod"
                           Appearance="Primary"
                           Command="{Binding ImportModArchiveCommand}"
                           Margin="0,0,12,0" />
                <ui:Button Icon="{ui:SymbolIcon Delete24}" 
                           Content="Clear Library" 
                           AutomationProperties.Name="Clear Library"
                           ToolTip="Permanently remove all mods from the library"
                           Command="{Binding ClearLibraryCommand}"
                           Appearance="Secondary" />
            </StackPanel>

            <!-- Unified Search Box & Category Filter Tabs -->
            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,15,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Category Filter Tabs (Pill Bar) -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="3" 
                        HorizontalAlignment="Left" 
                        Margin="0,0,0,0">
                    <WrapPanel>
                        <RadioButton x:Name="TabAssets" 
                                     IsChecked="True" 
                                     GroupName="CategoryTabs" 
                                     Style="{StaticResource SegmentTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" Filled="True" Margin="0,0,6,0" />
                                <TextBlock Text="Assets" VerticalAlignment="Center" />
                                <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding LibraryVM.AssetsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabPlugins" 
                                     GroupName="CategoryTabs" 
                                     Style="{StaticResource SegmentTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlugConnected24" Filled="True" Margin="0,0,6,0" />
                                <TextBlock Text="ASI Plugins" VerticalAlignment="Center" />
                                <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding LibraryVM.PluginsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabScripts" 
                                     GroupName="CategoryTabs" 
                                     Style="{StaticResource SegmentTabButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Code24" Filled="True" Margin="0,0,6,0" />
                                <TextBlock Text=".NET Scripts" VerticalAlignment="Center" />
                                <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding LibraryVM.ScriptsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>
                </Border>

                <ui:TextBox x:Name="ModSearchBox"
                            Grid.Row="1" 
                            Margin="0,10,0,0"
                            Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search for a mod, plugin, or script..."
                            Icon="{ui:SymbolIcon Search24}" />
            </Grid>
        </Grid>

        <!-- .img Archives Limit Counter -->
        <ui:Card Grid.Row="1" Margin="0,0,0,15" Padding="15">
            <ui:Card.Style>
                <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveImgArchiveCount}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:Card.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Top row: Info and Current count -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <WrapPanel Grid.Column="0">
                        <ui:SymbolIcon Symbol="Database24" Filled="True" Margin="0,0,8,0" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Warning">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Danger">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock Text="Active Custom .IMG Archives:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" />
                        <TextBlock Text=" " />
                        <TextBlock Text="{Binding ActiveImgArchiveStatus}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Warning">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Danger">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveImgArchiveCount}" FontSize="15" FontWeight="Black" Foreground="White" />
                        <TextBlock Text=" / 50 limit" FontSize="11" VerticalAlignment="Bottom" Foreground="White" Margin="2,0,0,2" />
                    </StackPanel>
                </Grid>
                
                <!-- Progress Bar -->
                <ProgressBar Grid.Row="1" Height="8" Minimum="0" Maximum="50" Value="{Binding ActiveImgArchiveCount}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Warning">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveImgArchiveSeverity}" Value="Danger">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                
                <!-- Warning description box (visible when warning or danger) -->
                <ui:InfoBar Grid.Row="2" 
                            Margin="0,10,0,0"
                            Title="{Binding ActiveImgArchiveWarningTitle}"
                            Message="{Binding ActiveImgArchiveWarningDescription}"
                            IsOpen="{Binding ActiveImgArchiveHasWarning}"
                            Severity="{Binding ActiveImgArchiveSeverity, Converter={StaticResource SeverityToInfoBarSeverityConverter}}" />
            </Grid>
        </ui:Card>

        <!-- Library Lists with Drag-and-Drop Reordering (Unclamped Full Width) -->
        <Grid x:Name="LibraryContentGrid" Grid.Row="2">
            <!-- TAB 1: ASSETS -->
            <ui:Card x:Name="AssetsListCard" 
                     Visibility="{Binding IsChecked, ElementName=TabAssets, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Margin="0,0,0,4" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Assets List (Mods)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Note: Mods placed in update/ load higher than FusionFix and override game files." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Priority: Higher overrides Lower" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    
                    <Border Grid.Row="1" Margin="12,0,12,12" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox x:Name="LibraryListBox" ItemsSource="{Binding LibraryVM.MainModsCollection}"
                                 SelectedItem="{Binding LibraryVM.SelectedLibraryMod, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource ModItemTemplate}"
                                 ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                 MouseMove="ListBox_MouseMove"
                                 DragOver="ListBox_DragOver"
                                 Drop="ListBox_Drop"
                                 AllowDrop="True"
                                 Background="Transparent"
                                 BorderThickness="0" />
                    </Border>
                </Grid>
            </ui:Card>

            <!-- TAB 2: ASI PLUGINS -->
            <ui:Card x:Name="PluginsListCard" 
                     Visibility="{Binding IsChecked, ElementName=TabPlugins, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Margin="0,0,0,4" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ASI Plugins List" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Note: Native plugins (.asi) are deployed to the plugins/ folder and require an ASI Loader." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Priority: Prefixed numeric order" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    
                    <Border Grid.Row="1" Margin="12,0,12,12" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox x:Name="PluginsListBox" ItemsSource="{Binding LibraryVM.PluginsCollection}"
                                 SelectedItem="{Binding LibraryVM.SelectedPluginMod, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource ModItemTemplate}"
                                 ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                 MouseMove="ListBox_MouseMove"
                                 DragOver="ListBox_DragOver"
                                 Drop="ListBox_Drop"
                                 AllowDrop="True"
                                 Background="Transparent"
                                 BorderThickness="0" />
                    </Border>
                </Grid>
            </ui:Card>

            <!-- TAB 3: .NET SCRIPTS -->
            <ui:Card x:Name="ScriptsListCard" 
                     Visibility="{Binding IsChecked, ElementName=TabScripts, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Margin="0,0,0,4" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text=".NET Scripts List" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Note: .NET scripts (.dll, .cs, .vb) are deployed to the scripts/ folder and require ScriptHook." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Priority: Load sequence" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    
                    <Border Grid.Row="1" Margin="12,0,12,12" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox x:Name="ScriptsListBox" ItemsSource="{Binding LibraryVM.ScriptsCollection}"
                                 SelectedItem="{Binding LibraryVM.SelectedScriptMod, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource ModItemTemplate}"
                                 ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                 MouseMove="ListBox_MouseMove"
                                 DragOver="ListBox_DragOver"
                                 Drop="ListBox_Drop"
                                 AllowDrop="True"
                                 Background="Transparent"
                                 BorderThickness="0" />
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>
        </Grid>
        </ScrollViewer>

        <Grid x:Name="DragOverOverlay" 
              Visibility="Collapsed" 
              Opacity="0"
              IsHitTestVisible="True"
              AllowDrop="True">
            <!-- Semi-transparent backdrop blur overlay -->
            <Border Background="#90000000" CornerRadius="8" />
            
            <Grid Margin="15">
                <!-- Glowing/Animated Border Shape -->
                <Rectangle x:Name="DashedBorder"
                           Stroke="{DynamicResource SystemAccentColorSecondaryBrush}" 
                           StrokeThickness="3" 
                           StrokeDashArray="4 2" 
                           RadiusX="8" RadiusY="8"
                           Fill="#EE1E1E1E">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="{DynamicResource SystemAccentColorSecondary}" BlurRadius="25" ShadowDepth="0" Opacity="0.55" />
                    </Rectangle.Effect>
                </Rectangle>
                
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderAdd48" Filled="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" FontSize="56" Margin="0,0,0,16" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop Mods or Archives here to import" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="Supports .zip, .rar, .7z archives and .asi files" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Mod Metadata Detail Card Modal Dialog -->
        <Grid Visibility="{Binding LibraryVM.IsEditingMod, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="100">
            <!-- Broader semi-transparent backdrop -->
            <Border Background="#99000000" />

            <!-- Non-transparent dialog card covering title/X down to Cancel/Save -->
            <Border Width="480" 
                    Padding="24" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Background="#FF202020"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.7" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Edit Mod Details" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Update mod metadata and display description" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" 
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding LibraryVM.CloseEditModCommand}"
                                   Appearance="Transparent"
                                   Padding="4"
                                   VerticalAlignment="Top" />
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding LibraryVM.EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Version" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding LibraryVM.EditingVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Compatibility" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding LibraryVM.EditingCompatibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding LibraryVM.EditingDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                   AcceptsReturn="True" 
                                   TextWrapping="Wrap" 
                                   MinLines="3" 
                                   MaxLines="5" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" 
                                   Content="Cancel" 
                                   Command="{Binding LibraryVM.CloseEditModCommand}"
                                   Appearance="Secondary" 
                                   HorizontalAlignment="Stretch" 
                                   Margin="0,0,6,0" />
                        <ui:Button Grid.Column="1" 
                                   Content="Save Changes" 
                                   Command="{Binding LibraryVM.SaveModDetailsCommand}"
                                   Appearance="Primary" 
                                   HorizontalAlignment="Stretch" 
                                   Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
