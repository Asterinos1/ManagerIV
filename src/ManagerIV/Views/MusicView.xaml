<UserControl x:Class="ManagerIV.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ManagerIV.Views"
             xmlns:vm="clr-namespace:ManagerIV.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000"
             AllowDrop="True"
             Drop="UserControl_Drop"
             DragOver="UserControl_DragOver"
             DragEnter="UserControl_DragEnter"
             DragLeave="UserControl_DragLeave"
             Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Storyboard x:Key="MarchingAnts">
            <DoubleAnimation Storyboard.TargetName="DashedBorder" 
                             Storyboard.TargetProperty="StrokeDashOffset" 
                             From="0" To="12" 
                             Duration="0:0:1" 
                             RepeatBehavior="Forever" />
        </Storyboard>
        <Storyboard x:Key="FadeInOverlay">
            <DoubleAnimation Storyboard.TargetName="DragOverOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.25" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Independence FM Music Manager" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Import music, toggle active tracks, edit metadata, and deploy to Rockstar Games User Music." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Icon="{ui:SymbolIcon Delete24}" 
                               Content="Clear Library" 
                               Command="{Binding Music.ClearMusicCommand}"
                               Appearance="Danger"
                               Margin="0,0,10,0" />
                    <ui:Button Icon="{ui:SymbolIcon FolderAdd24}" 
                               Content="Import Audio Files" 
                               Command="{Binding Music.ImportTracksCommand}"
                               Appearance="Secondary" />
                </StackPanel>
            </Grid>

            <!-- Status Banner -->
            <ui:Card Grid.Row="1" 
                     Margin="0,0,0,12" 
                     Padding="10" 
                     Background="{DynamicResource ControlFillColorTertiaryBrush}"
                     Visibility="{Binding Music.NeedsMoreTracks, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Independence FM requires at least 3 enabled songs to play in-game." 
                               VerticalAlignment="Center" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </ui:Card>

            <!-- Main Content Area: 2 Columns -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="450" />
                    <ColumnDefinition Width="8" />   <!-- Splitter -->
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- Column 1: Music Library List -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Music Library" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Music.TracksCountText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Custom Header Row (Replaces GridView Headers) -->
                    <Border Grid.Row="1" Background="{DynamicResource ControlFillColorTertiaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4,4,0,0" Padding="10,8,25,8" Margin="0,0,0,-1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Order" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Title" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Artist" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="Time" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="" /> <!-- Actions space -->
                        </Grid>
                    </Border>

                    <ui:Card Grid.Row="2" Padding="0" BorderThickness="1" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                        <ListBox ItemsSource="{Binding Music.AllTracks}" 
                                 SelectedItem="{Binding Music.SelectedTrack, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- A bottom border mimics list dividers -->
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,6" Margin="0" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" 
                                                      IsChecked="{Binding IsEnabled, Mode=OneWay}" 
                                                      Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.Music.ToggleTrackEnabledCommand}"
                                                      CommandParameter="{Binding}"
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:Button Icon="{ui:SymbolIcon ChevronUp24}" 
                                                           Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.Music.MoveTrackUpCommand}"
                                                           CommandParameter="{Binding}"
                                                           Padding="2" 
                                                           Margin="0,0,2,0" 
                                                           Appearance="Transparent" />
                                                <ui:Button Icon="{ui:SymbolIcon ChevronDown24}" 
                                                           Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.Music.MoveTrackDownCommand}"
                                                           CommandParameter="{Binding}"
                                                           Padding="2" 
                                                           Appearance="Transparent" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="5,0,5,0" VerticalAlignment="Center" />
                                            
                                            <TextBlock Grid.Column="3" Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="5,0,5,0" VerticalAlignment="Center" />
                                            
                                            <TextBlock Grid.Column="4" Text="{Binding Duration, StringFormat=\{0:mm\\:ss\}}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            
                                            <ui:Button Grid.Column="5" 
                                                       Icon="{ui:SymbolIcon Delete24}"
                                                       Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.Music.DeleteTrackCommand}"
                                                       CommandParameter="{Binding}"
                                                       Appearance="Transparent"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       Padding="4" 
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ui:Card>
                </Grid>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

                <!-- Column 2: Metadata Editor & Deploy -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Song Metadata Editor" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <ui:Card Grid.Row="1" Padding="15" VerticalAlignment="Top">
                        <Grid>
                            <!-- Placeholder -->
                            <TextBlock Text="Select a song to edit metadata." 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Music.SelectedTrack}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Editor -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Music.SelectedTrack}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                    <TextBlock Text="Title" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding Music.EditingTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                                    <TextBlock Text="Artist" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding Music.EditingArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                                    <TextBlock Text="Album" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding Music.EditingAlbum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="Duration: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Music.SelectedTrack.Duration, StringFormat=\{0:mm\\:ss\}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>

                                <ui:Button Grid.Row="4" 
                                           Content="Save Metadata" 
                                           Icon="{ui:SymbolIcon Save24}" 
                                           Command="{Binding Music.SaveTrackMetadataCommand}"
                                           Appearance="Secondary"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                    </ui:Card>

                    <ui:Button Grid.Row="2" 
                               Content="Deploy Music to Game" 
                               Command="{Binding Music.DeployMusicCommand}"
                               Appearance="Primary" 
                               Height="44" 
                               FontWeight="SemiBold"
                               FontSize="16"
                               HorizontalAlignment="Stretch"
                               Margin="0,15,0,0" />
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <TextBlock Grid.Row="3" 
                       Text="{Binding Music.StatusText}" 
                       FontSize="12" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       Margin="0,15,0,0" 
                       TextWrapping="Wrap" />
        </Grid>

        <!-- Drag Over Overlay -->
        <Grid x:Name="DragOverOverlay" 
              Visibility="Collapsed" 
              Opacity="0"
              IsHitTestVisible="True"
              AllowDrop="True">
            <Border Background="#90000000" CornerRadius="8" />
            
            <Grid Margin="15">
                <!-- Glowing/Animated Border Shape -->
                <Rectangle x:Name="DashedBorder"
                           Stroke="{DynamicResource SystemAccentColorSecondaryBrush}" 
                           StrokeThickness="3" 
                           StrokeDashArray="4 2" 
                           RadiusX="8" RadiusY="8"
                           Fill="#EE1E1E1E">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="{DynamicResource SystemAccentColorSecondary}" BlurRadius="25" ShadowDepth="0" Opacity="0.55" />
                    </Rectangle.Effect>
                </Rectangle>
                
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="MusicNote224" Filled="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" FontSize="56" Margin="0,0,0,16" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop Audio Files here to import" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="Supports .mp3, .wma, and .m4a files" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
