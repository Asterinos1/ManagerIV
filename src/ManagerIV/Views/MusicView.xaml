<UserControl x:Class="ManagerIV.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ManagerIV.Views"
             xmlns:vm="clr-namespace:ManagerIV.ViewModels"
             xmlns:core="clr-namespace:ManagerIV.Core"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000"
             AllowDrop="True"
             Drop="UserControl_Drop"
             DragOver="UserControl_DragOver"
             DragEnter="UserControl_DragEnter"
             DragLeave="UserControl_DragLeave"
             Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <UserControl.Resources>
        <core:MusicTrackToIndexConverter x:Key="MusicTrackToIndexConverter" />
        <Style x:Key="CleanListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <DataTemplate x:Key="MusicTrackTemplate" DataType="{x:Type core:MusicTrack}">
            <Border BorderThickness="1" 
                    CornerRadius="6"
                    Padding="6,6" 
                    Margin="4,2,8,4" 
                    HorizontalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />  <!-- Drag Handle & Order -->
                        <ColumnDefinition Width="50" />  <!-- Enable toggle / CheckBox -->
                        <ColumnDefinition Width="2*" />   <!-- Title -->
                        <ColumnDefinition Width="1.5*" /> <!-- Artist -->
                        <ColumnDefinition Width="60" />  <!-- Time -->
                        <ColumnDefinition Width="75" />  <!-- Actions: Edit & Delete -->
                    </Grid.ColumnDefinitions>

                    <!-- Drag Handle & Order number (1-based index) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ReOrderDotsVertical24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="18" Margin="0,0,4,0" Cursor="SizeAll" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Width="25" VerticalAlignment="Center" TextAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource MusicTrackToIndexConverter}">
                                    <Binding />
                                    <Binding Path="DataContext.Music.AllTracks" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <!-- Enable Toggle CheckBox right after Order -->
                    <CheckBox Grid.Column="1" 
                              IsChecked="{Binding IsEnabled, Mode=OneWay}" 
                              Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.Music.ToggleTrackEnabledCommand}"
                              CommandParameter="{Binding}"
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="5,0,5,0" VerticalAlignment="Center" />
                    
                    <TextBlock Grid.Column="3" Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="5,0,5,0" VerticalAlignment="Center" />
                    
                    <TextBlock Grid.Column="4" Text="{Binding Duration, StringFormat=\{0:mm\\:ss\}}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                    
                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                   Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.Music.EditTrackCommand}"
                                   CommandParameter="{Binding}"
                                   Appearance="Transparent"
                                   ToolTip="Edit Track Metadata"
                                   Padding="4" 
                                   Margin="0,0,4,0" />
                        <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                   Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.Music.DeleteTrackCommand}"
                                   CommandParameter="{Binding}"
                                   Appearance="Transparent"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   ToolTip="Delete Track"
                                   Padding="4" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Storyboard x:Key="MarchingAnts">
            <DoubleAnimation Storyboard.TargetName="DashedBorder" 
                             Storyboard.TargetProperty="StrokeDashOffset" 
                             From="0" To="12" 
                             Duration="0:0:1" 
                             RepeatBehavior="Forever" />
        </Storyboard>
        <Storyboard x:Key="FadeInOverlay">
            <DoubleAnimation Storyboard.TargetName="DragOverOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.25" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Independence FM Music Manager" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Import music, toggle active tracks, edit metadata, and deploy to Rockstar Games User Music." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Icon="{ui:SymbolIcon Play24}" 
                               Content="Deploy Music to Game" 
                               Command="{Binding Music.DeployMusicCommand}"
                               Appearance="Primary"
                               Margin="0,0,10,0" />
                    <ui:Button Icon="{ui:SymbolIcon FolderAdd24}" 
                               Content="Import Audio Files" 
                               Command="{Binding Music.ImportTracksCommand}"
                               Appearance="Secondary"
                               Margin="0,0,10,0" />
                    <ui:Button Icon="{ui:SymbolIcon Delete24}" 
                               Content="Clear Library" 
                               Command="{Binding Music.ClearMusicCommand}"
                               Appearance="Secondary" />
                </StackPanel>
            </Grid>

            <!-- Status Banner -->
            <ui:Card Grid.Row="1" 
                     Margin="0,0,0,12" 
                     Padding="10" 
                     Background="{DynamicResource ControlFillColorTertiaryBrush}"
                     Visibility="{Binding Music.NeedsMoreTracks, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Independence FM requires at least 3 enabled songs to play in-game." 
                               VerticalAlignment="Center" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </ui:Card>

            <!-- Main Content Area: Unclamped Full-Width Music List -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Music Library" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Music.TracksCountText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Custom Header Row (Replaces GridView Headers) -->
                <Border Grid.Row="1" Background="{DynamicResource ControlFillColorTertiaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6,6,0,0" Padding="8,8,12,8" Margin="0,0,0,-1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />  <!-- Order -->
                            <ColumnDefinition Width="50" />  <!-- Enable -->
                            <ColumnDefinition Width="2*" />   <!-- Title -->
                            <ColumnDefinition Width="1.5*" /> <!-- Artist -->
                            <ColumnDefinition Width="60" />  <!-- Time -->
                            <ColumnDefinition Width="75" />  <!-- Actions -->
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Order" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Enable" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Title" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Artist" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Time" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Actions" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="0,0,6,6" Padding="4">
                    <ListBox x:Name="MusicListBox" ItemsSource="{Binding Music.AllTracks}" 
                             SelectedItem="{Binding Music.SelectedTrack, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemTemplate="{StaticResource MusicTrackTemplate}"
                             ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                             PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                             MouseMove="ListBox_MouseMove"
                             DragOver="ListBox_DragOver"
                             Drop="ListBox_Drop"
                             AllowDrop="True" />
                </Border>
            </Grid>

            <!-- Status Bar -->
            <TextBlock Grid.Row="3" 
                       Text="{Binding Music.StatusText}" 
                       FontSize="12" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       Margin="0,15,0,0" 
                       TextWrapping="Wrap" />
        </Grid>

        <!-- Song Metadata Detail Card Popup / Modal -->
        <Grid Visibility="{Binding Music.IsEditingTrack, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="100">
            <Border Background="#99000000" />
            <!-- Non-transparent dialog card covering title/X down to Cancel/Save -->
            <Border Width="480" 
                    Padding="24" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Background="#FF202020"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.7" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Edit Track Details" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Update tags for Independence FM in-game display" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" 
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding Music.CloseEditTrackCommand}"
                                   Appearance="Transparent"
                                   Padding="4"
                                   VerticalAlignment="Top" />
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Title" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Music.EditingTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Artist" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Music.EditingArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Album" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Music.EditingAlbum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Duration: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Music.SelectedTrack.Duration, StringFormat=\{0:mm\\:ss\}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" 
                                   Content="Cancel" 
                                   Command="{Binding Music.CloseEditTrackCommand}"
                                   Appearance="Secondary"
                                   Margin="0,0,6,0"
                                   HorizontalAlignment="Stretch" />
                        <ui:Button Grid.Column="1" 
                                   Content="Save Changes" 
                                   Icon="{ui:SymbolIcon Save24}" 
                                   Command="{Binding Music.SaveTrackMetadataCommand}"
                                   Appearance="Primary"
                                   Margin="6,0,0,0"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Drag Over Overlay -->
        <Grid x:Name="DragOverOverlay" 
              Visibility="Collapsed" 
              Opacity="0"
              IsHitTestVisible="True"
              AllowDrop="True">
            <Border Background="#90000000" CornerRadius="8" />
            
            <Grid Margin="15">
                <!-- Glowing/Animated Border Shape -->
                <Rectangle x:Name="DashedBorder"
                           Stroke="{DynamicResource SystemAccentColorSecondaryBrush}" 
                           StrokeThickness="3" 
                           StrokeDashArray="4 2" 
                           RadiusX="8" RadiusY="8"
                           Fill="#EE1E1E1E">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="{DynamicResource SystemAccentColorSecondary}" BlurRadius="25" ShadowDepth="0" Opacity="0.55" />
                    </Rectangle.Effect>
                </Rectangle>
                
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="MusicNote224" Filled="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" FontSize="56" Margin="0,0,0,16" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop Audio Files here to import" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="Supports .mp3, .wma, and .m4a files" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
