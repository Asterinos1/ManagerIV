<UserControl x:Class="ManagerIV.Views.ProfileSwitcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ManagerIV.Views"
             xmlns:vm="clr-namespace:ManagerIV.ViewModels"
             xmlns:core="clr-namespace:ManagerIV.Core"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             SizeChanged="UserControl_SizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <core:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="20" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Profiles &amp; Configuration" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Manage named profiles, game directories, and inspect game update status." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Main Scrollable Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ContentGrid" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="0" /> <!-- Third column for wide layouts, dynamically resized -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left Panel (Profiles list, Create profile, Theme settings) -->
                <StackPanel x:Name="LeftPanel" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,10,15">
                    <!-- Create Profile Card -->
                    <ui:Card Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Create New Profile" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                            <ui:TextBox x:Name="ProfileNameInput" PlaceholderText="Profile Name (e.g. Graphics Mod Set)" Margin="0,0,0,10" />
                            <ui:Button Content="Create Profile" 
                                       Icon="{ui:SymbolIcon Add24}" 
                                       Command="{Binding CreateProfileCommand}" 
                                       CommandParameter="{Binding Text, ElementName=ProfileNameInput}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Select Profile Card -->
                    <ui:Card Padding="15">
                        <StackPanel>
                            <TextBlock Text="Available Profiles" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                            <ListBox ItemsSource="{Binding Profiles}"
                                     SelectedItem="{Binding ActiveProfile}"
                                     MaxHeight="300"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                <ui:SymbolIcon Grid.Column="1" Symbol="Checkmark24" Filled="True" Foreground="#FF107C41" Margin="10,0,0,0" VerticalAlignment="Center" 
                                                               Visibility="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ui:Card>

                    <!-- Save Profiles Card -->
                    <ui:Card Padding="15" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="GTA IV Save Game Profiles" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,5" />
                            <TextBlock Text="GTA IV stores your save files in user profiles. Switch save states or start a new story." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                            <!-- Select base profile ID dropdown -->
                            <TextBlock Text="Social Club Profile ID" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" 
                                          ItemsSource="{Binding BaseProfileIds}" 
                                          SelectedItem="{Binding SelectedBaseProfileId}" 
                                          HorizontalAlignment="Stretch"
                                          Visibility="{Binding BaseProfileIds.Count, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}" />
                                <ui:Button Grid.Column="1" 
                                           Icon="{ui:SymbolIcon ArrowClockwise24}" 
                                           Command="{Binding RefreshSaveProfilesCommand}" 
                                           Margin="8,0,0,0" 
                                           ToolTip="Refresh Save Profiles" />
                            </Grid>
                            
                            <!-- If no profiles are found, show error -->
                            <TextBlock Text="No Social Club Profile directories detected. Check the path in Settings." 
                                       Foreground="#FFD83B01" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,10"
                                       Visibility="{Binding BaseProfileIds.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Collapsed}" />

                            <!-- Save Profiles List -->
                            <TextBlock Text="Save States" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding SaveProfiles}"
                                     SelectedItem="{Binding SelectedSaveProfile}"
                                     MaxHeight="180"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="0,0,0,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding FolderName}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="5,0,0,0"
                                                        Background="#FF107C41"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Active" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Selected Save profile controls -->
                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0"
                                    Visibility="{Binding SelectedSaveProfile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Activate Selected -->
                                    <TextBlock Text="Activate Save State" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Before activating, name the current active save to archive it (e.g. StoryModSave):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding RenameActiveSaveTo, Mode=TwoWay}" PlaceholderText="Archive active save as..." Margin="0,0,8,0" />
                                        <ui:Button Grid.Column="1" Content="Activate" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ActivateSaveProfileCommand}" CommandParameter="{Binding RenameActiveSaveTo}" Appearance="Primary" />
                                    </Grid>

                                    <!-- Rename Save State -->
                                    <TextBlock Text="Rename Save State" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,4" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" x:Name="RenameSaveStateInput" PlaceholderText="New name..." Margin="0,0,8,0" />
                                        <ui:Button Grid.Column="1" Content="Rename" Icon="{ui:SymbolIcon Edit24}" Command="{Binding RenameSaveProfileCommand}" CommandParameter="{Binding Text, ElementName=RenameSaveStateInput}" />
                                    </Grid>

                                    <!-- Delete Save State -->
                                    <ui:Button Content="Delete Save State" 
                                               Icon="{ui:SymbolIcon Delete24}" 
                                               Command="{Binding DeleteSaveProfileCommand}" 
                                               Appearance="Danger" 
                                               HorizontalAlignment="Right" 
                                               Visibility="{Binding SelectedSaveProfile.IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- Create New Save State / Fresh Story -->
                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Start New Story / Save State" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                                    
                                    <TextBlock Text="Name of the new story save (e.g. LCPDFR Story):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                    <ui:TextBox Text="{Binding NewSaveProfileName, Mode=TwoWay}" PlaceholderText="New Save Name..." Margin="0,0,0,8" />

                                    <TextBlock Text="Name to archive the currently active save state:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                    <ui:TextBox Text="{Binding RenameActiveSaveTo, Mode=TwoWay}" PlaceholderText="Archive active save as..." Margin="0,0,0,10" />

                                    <ui:Button Content="Create Fresh Story Save" 
                                               Icon="{ui:SymbolIcon Add24}" 
                                               Command="{Binding CreateSaveProfileCommand}" 
                                               Appearance="Secondary"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Active Details Card -->
                <ui:Card x:Name="ConfigCard" Grid.Column="1" Grid.Row="0" Padding="15" Margin="10,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Active Configuration" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,15" />

                        <TextBlock Text="Profile Name" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid Margin="0,2,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" x:Name="ProfileNameEditInput" Text="{Binding ActiveProfile.Name, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ui:Button Grid.Column="1" Content="Rename" Icon="{ui:SymbolIcon Edit24}" Command="{Binding RenameProfileCommand}" CommandParameter="{Binding Text, ElementName=ProfileNameEditInput}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Game Directory (GTAIV.exe Path)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid Margin="0,2,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ActiveProfile.GamePath}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ui:Button Grid.Column="1" Content="Browse..." Icon="{ui:SymbolIcon Folder24}" Command="{Binding SelectGameDirCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Mods Library Directory" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActiveProfile.LibraryPath}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,12" TextWrapping="Wrap" />

                        <TextBlock Text="Detected Game Version" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                            <TextBlock Text="{Binding ActiveProfile.LastKnownVersion.Version, FallbackValue='Unknown'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text=" (Complete Edition)" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0" Visibility="{Binding ActiveProfile.LastKnownVersion.IsCompleteEdition, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text=" (Legacy)" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0" Visibility="{Binding ActiveProfile.LastKnownVersion.IsCompleteEdition, FallbackValue=Collapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <TextBlock Text="Last Known Executable Hash" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActiveProfile.LastKnownVersion.ExecutableHash, FallbackValue='None recorded'}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,12" TextWrapping="Wrap" />

                        <TextBlock Text="Total Enabled Mods" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActiveProfile.EnabledModIds.Count}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,12" />

                        <ui:Button Content="Delete Profile" 
                                   Icon="{ui:SymbolIcon Delete24}" 
                                   Command="{Binding RemoveProfileCommand}"
                                   Appearance="Danger"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </ui:Card>

                <!-- Status & Warning Panel -->
                <StackPanel x:Name="StatusPanel" Grid.Column="1" Grid.Row="1" Margin="10,0,0,15">
                    <!-- Backend Loaders Status Card -->
                    <ui:Card Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Loader &amp; Hook Status" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,15" />

                            <!-- Ultimate ASI Loader -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Ultimate ASI Loader" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="dinput8.dll" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BackendStatus.AsiLoaderVersionInfo}" FontSize="10" Foreground="#FF0078D4" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                        Background="{Binding BackendStatus.AsiLoaderBrush}">
                                    <TextBlock Text="{Binding BackendStatus.AsiLoaderText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>

                            <Separator Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,5" />

                            <!-- FusionFix -->
                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="FusionFix" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="plugins/GTAIV.FusionFix.asi" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BackendStatus.FusionFixVersionInfo}" FontSize="10" Foreground="#FF0078D4" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                        Background="{Binding BackendStatus.FusionFixBrush}">
                                    <TextBlock Text="{Binding BackendStatus.FusionFixText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>

                            <Separator Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,5" />

                            <!-- DXVK -->
                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DXVK (Vulkan Translation)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="d3d9.dll / vulkan.dll" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BackendStatus.DxvkVersionInfo}" FontSize="10" Foreground="#FF0078D4" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                        Background="{Binding BackendStatus.DxvkBrush}">
                                    <TextBlock Text="{Binding BackendStatus.DxvkText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>

                            <Separator Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,5" />

                            <!-- ScriptHook -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ScriptHook" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="ScriptHook.dll / ScriptHookDotNet" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                        Background="{Binding BackendStatus.ScriptHookBrush}">
                                    <TextBlock Text="{Binding BackendStatus.ScriptHookText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>

                            <Separator Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,10" />

                            <!-- Installation Controllers -->
                            <TextBlock Text="FusionFix (Preferred Bundle)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="{Binding BackendStatus.FusionFixButtonText}" 
                                           Icon="{ui:SymbolIcon ArrowDownload24}" 
                                           Command="{Binding InstallFusionFixCommand}"
                                           Appearance="Primary"
                                           Margin="0,0,4,0"
                                           HorizontalAlignment="Stretch" />
                                <ui:Button Grid.Column="1" Content="Uninstall" 
                                           Icon="{ui:SymbolIcon Delete24}" 
                                           Command="{Binding UninstallFusionFixCommand}"
                                           Appearance="Secondary"
                                           Margin="4,0,0,0"
                                           HorizontalAlignment="Stretch" />
                            </Grid>

                            <TextBlock Text="Ultimate ASI Loader (Standalone)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,10,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="{Binding BackendStatus.AsiLoaderButtonText}" 
                                           Icon="{ui:SymbolIcon ArrowDownload24}" 
                                           Command="{Binding InstallAsiLoaderCommand}"
                                           Appearance="Primary"
                                           Margin="0,0,4,0"
                                           HorizontalAlignment="Stretch" />
                                <ui:Button Grid.Column="1" Content="Uninstall" 
                                           Icon="{ui:SymbolIcon Delete24}" 
                                           Command="{Binding UninstallAsiLoaderCommand}"
                                           Appearance="Secondary"
                                           Margin="4,0,0,0"
                                           HorizontalAlignment="Stretch" />
                            </Grid>

                            <TextBlock Text="DXVK (Standalone)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,10,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="{Binding BackendStatus.DxvkButtonText}" 
                                           Icon="{ui:SymbolIcon ArrowDownload24}" 
                                           Command="{Binding InstallDxvkCommand}"
                                           Appearance="Primary"
                                           Margin="0,0,4,0"
                                           HorizontalAlignment="Stretch" />
                                <ui:Button Grid.Column="1" Content="Uninstall" 
                                           Icon="{ui:SymbolIcon Delete24}" 
                                           Command="{Binding UninstallDxvkCommand}"
                                           Appearance="Secondary"
                                           Margin="4,0,0,0"
                                           HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Watchdog Mismatch Alert Card -->
                    <Border x:Name="WatchdogWarningCard" 
                            CornerRadius="4" 
                            Background="#FFD83B01" 
                            Padding="15" 
                            Visibility="{Binding HasWatchdogWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Warning24" Filled="True" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Text="GTAIV.exe Version Warning" FontSize="14" FontWeight="Bold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding WatchdogWarning}" FontSize="12" Foreground="White" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
