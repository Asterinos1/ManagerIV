<UserControl x:Class="ManagerIV.Views.ProfileSwitcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ManagerIV.Views"
             xmlns:vm="clr-namespace:ManagerIV.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Profiles &amp; Configuration" FontSize="24" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Manage named profiles, game directories, and inspect game update status." FontSize="13" Foreground="#FFAAAAAA" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Profiles List and Creation -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <!-- Create Profile Card -->
                <ui:Card Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Create New Profile" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />
                        <ui:TextBox x:Name="ProfileNameInput" PlaceholderText="Profile Name (e.g. Graphics Mod Set)" Margin="0,0,0,10" />
                        <ui:Button Content="Create Profile" 
                                   Icon="{ui:SymbolIcon Add24}" 
                                   Command="{Binding CreateProfileCommand}" 
                                   CommandParameter="{Binding Text, ElementName=ProfileNameInput}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </ui:Card>

                <!-- Select Profile Card -->
                <ui:Card Padding="15">
                    <StackPanel>
                        <TextBlock Text="Available Profiles" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />
                        <ListBox ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding ActiveProfile}"
                                 MaxHeight="300"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" BorderBrush="#FF2D2D2D" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                            <ui:SymbolIcon Grid.Column="1" Symbol="Checkmark24" Filled="True" Foreground="#FF107C41" Margin="10,0,0,0" VerticalAlignment="Center" 
                                                           Visibility="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- Active Profile Details & Watchdog Warning -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <!-- Active Details Card -->
                <ui:Card Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Active Configuration" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />

                        <TextBlock Text="Profile Name" FontSize="11" Foreground="#FFAAAAAA" />
                        <Grid Margin="0,2,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" x:Name="ProfileNameEditInput" Text="{Binding ActiveProfile.Name, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ui:Button Grid.Column="1" Content="Rename" Icon="{ui:SymbolIcon Edit24}" Command="{Binding RenameProfileCommand}" CommandParameter="{Binding Text, ElementName=ProfileNameEditInput}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Game Directory (GTAIV.exe Path)" FontSize="11" Foreground="#FFAAAAAA" />
                        <Grid Margin="0,2,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ActiveProfile.GamePath}" FontSize="13" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ui:Button Grid.Column="1" Content="Browse..." Icon="{ui:SymbolIcon Folder24}" Command="{Binding SelectGameDirCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Mods Library Directory" FontSize="11" Foreground="#FFAAAAAA" />
                        <TextBlock Text="{Binding ActiveProfile.LibraryPath}" FontSize="13" Foreground="White" Margin="0,2,0,12" TextWrapping="Wrap" />

                        <TextBlock Text="Last Known Executable Hash" FontSize="11" Foreground="#FFAAAAAA" />
                        <TextBlock Text="{Binding ActiveProfile.LastKnownVersion.ExecutableHash, FallbackValue='None recorded'}" FontSize="11" Foreground="#FFAAAAAA" Margin="0,2,0,12" TextWrapping="Wrap" />

                        <TextBlock Text="Total Enabled Mods" FontSize="11" Foreground="#FFAAAAAA" />
                        <TextBlock Text="{Binding ActiveProfile.EnabledModIds.Count}" FontSize="13" Foreground="White" Margin="0,2,0,12" />

                        <ui:Button Content="Delete Profile" 
                                   Icon="{ui:SymbolIcon Delete24}" 
                                   Command="{Binding RemoveProfileCommand}"
                                   Appearance="Danger"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </ui:Card>

                <!-- Watchdog Mismatch Alert Card -->
                <Border x:Name="WatchdogWarningCard" 
                        CornerRadius="4" 
                        Background="#FFD83B01" 
                        Padding="15" 
                        Visibility="{Binding HasWatchdogWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Warning24" Filled="True" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="GTAIV.exe Version Warning" FontSize="14" FontWeight="Bold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding WatchdogWarning}" FontSize="12" Foreground="White" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
